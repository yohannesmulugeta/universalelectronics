---
import { existsSync } from 'node:fs';
import { withBase } from '../lib/paths';
import { responsiveImage } from '../lib/responsiveImage';
const hasLicensedVideo = existsSync(new URL('../../public/assets/hero/universal-energy-loop.mp4', import.meta.url));
---
<section class="ue-cinema-hero" aria-labelledby="home-heading">
 <div class="max-w-site mx-auto px-5 pb-10 pt-16 text-center sm:px-8 sm:pt-20 lg:pb-12 lg:pt-24">
  <p class="section-eyebrow mb-5">Universal Electronics · Addis Ababa</p>
  <h1 id="home-heading" class="ue-cinema-heading mx-auto max-w-5xl font-serif font-extrabold text-brand-navy">
   Power your world.<span class="block text-brand-blue">Amplify every moment.</span>
  </h1>
  <p class="mx-auto mt-6 max-w-2xl text-base leading-8 text-brand-muted sm:text-lg">
   Solar energy, reliable backup equipment and professional sound systems for homes, businesses and ambitious projects in Ethiopia.
  </p>
  <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
   <a href={withBase('/shop/solar/')} class="button-primary">Explore Solar <span aria-hidden="true">↗</span></a>
   <a href={withBase('/shop/sound/')} class="button-secondary">Explore Sound <span aria-hidden="true">↗</span></a>
  </div>
 </div>
 <div class="ue-cinema-stage mx-auto">
  <a href={withBase('/solutions/solar-power/')} class="ue-cinema-main ue-cinema-link group" aria-label="Explore solar power and backup energy solutions">
   <img class="ue-cinema-home-image" src={withBase('/assets/hero/night-home.svg')}
    alt="Original concept illustration of a house at night showing rooftop solar panels, illuminated rooms, backup battery, and energy flow"
    fetchpriority="high" loading="eager" decoding="async" width="1200" height="720" />
   {hasLicensedVideo && (
    <video class="ue-cinema-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true"
      poster={withBase('/assets/hero/night-home.svg')}>
     <source src={withBase('/assets/hero/universal-energy-loop.mp4')} type="video/mp4" />
    </video>
   )}
   <span class="ue-cinema-photo-shade" aria-hidden="true"></span>
   <div class="ue-cinema-bottom">
    <span class="ue-cinema-tag">Energy that supports your day</span>
    <h2>Solar &amp; Backup Power</h2>
    <p>Explore solar panels, inverters and batteries.</p>
   </div>
   <span class="ue-cinema-arrow" aria-hidden="true">↗</span>
   <span class="ue-cinema-image-note">Concept energy visualization</span>
  </a>
  <a href={withBase('/solutions/professional-sound/')} class="ue-cinema-sound ue-cinema-link group" aria-label="Explore professional sound equipment">
   <span class="ue-cinema-sound-glow" aria-hidden="true"></span>
   <img src={responsiveImage('/assets/products/speakers/4980-01._JBL_EON715_3-4_Extreme_vert_medium.png',960).src}
      srcset={responsiveImage('/assets/products/speakers/4980-01._JBL_EON715_3-4_Extreme_vert_medium.png',960).srcSet}
      sizes="(max-width: 900px) 94vw, 34vw" alt="JBL EON715 professional PA loudspeaker from our product catalog" loading="eager" decoding="async" width="600" height="800" />
   <span class="ue-cinema-photo-shade" aria-hidden="true"></span>
   <span class="ue-cinema-sound-lines" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
   <div class="ue-cinema-bottom">
    <span class="ue-cinema-tag">Sound that brings people together</span>
    <h2>Professional Sound</h2>
    <p>Speakers, microphones and audio systems.</p>
   </div>
   <span class="ue-cinema-arrow" aria-hidden="true">↗</span>
  </a>
 </div>
 <div class="max-w-site mx-auto flex flex-wrap items-center justify-between gap-3 px-5 py-5 text-xs font-medium text-brand-muted sm:px-8">
  <span>Solar energy <span class="mx-2 text-brand-blue">/</span> Professional sound</span>
  <a href={withBase('/contact/')} class="font-semibold text-brand-blue hover:underline">Request a quotation ↗</a>
 </div>
</section>
{hasLicensedVideo && <script>
 const video = document.querySelector<HTMLVideoElement>('.ue-cinema-video');
 if (video) {
  const media = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (media.matches) { video.pause(); }
  else if ('IntersectionObserver' in window) {
   const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
     if (entry.isIntersecting && !media.matches) video.play().catch(()=>{});
     else video.pause();
    }
   }, { threshold: 0.1 });
   observer.observe(video);
  }
 }
</script>}
