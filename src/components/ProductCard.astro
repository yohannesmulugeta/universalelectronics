---
import { withBase } from '../lib/paths';
import type { Product } from '../types';
import { siteConfig } from '../data/siteConfig';

interface Props {
  product: Product;
}

const { product } = Astro.props;

const hasImage = product.media && product.media.length > 0;
const primaryImage = hasImage ? product.media[0] : null;

// Clean pre-filled telegram text
const telegramText = encodeURIComponent(
  `Hello Universal Electronics, I would like to ask about ${product.title}.`
);
const telegramLink = `${siteConfig.telegramUrl}?text=${telegramText}`;
---

<div class="group flex flex-col bg-white rounded-lg border border-brand-border/90 hover:border-brand-blue/50 hover:shadow-md transition-all duration-200 overflow-hidden">
  <!-- Image Container -->
  <a
    href={withBase(`/product/${product.slug}/`)}
    class="relative block aspect-[4/3] bg-brand-offwhite overflow-hidden border-b border-slate-100 focus:outline-none"
    tabindex="-1"
    aria-hidden="true"
  >
    {
      hasImage && primaryImage ? (
        <img
          src={withBase(primaryImage)}
          alt={product.title}
          class="w-full h-full object-contain p-4 group-hover:scale-105 transition-transform duration-300"
          loading="lazy"
          width="400"
          height="300"
        />
      ) : (
        <div class="w-full h-full flex flex-col items-center justify-center p-6 text-center text-slate-400 bg-slate-50">
          <svg class="w-12 h-12 mb-2 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span class="text-xs font-medium text-slate-500">Image unavailable</span>
        </div>
      )
    }

    <!-- Badges -->
    <div class="absolute top-2.5 left-2.5 flex flex-wrap gap-1">
      <span class="px-2 py-0.5 rounded text-[11px] font-medium bg-white/95 text-brand-navy shadow-sm border border-slate-200/80">
        {product.categoryName}
      </span>
    </div>
  </a>

  <!-- Content Body -->
  <div class="p-4 flex flex-col flex-grow">
    <!-- Brand -->
    <div class="flex items-center justify-between text-xs text-brand-muted mb-1.5">
      <span class="font-medium text-brand-blue truncate">{product.primaryBrand}</span>
      <span class="text-[11px] text-slate-400 capitalize">{product.section}</span>
    </div>

    <!-- Product Title -->
    <h3 class="font-medium text-brand-dark text-sm sm:text-base line-clamp-2 min-h-[2.5rem] sm:min-h-[3rem] mb-2 group-hover:text-brand-blue transition-colors">
      <a href={withBase(`/product/${product.slug}/`)} class="focus:outline-none">
        {product.title}
      </a>
    </h3>

    <!-- Footer Actions -->
    <div class="mt-auto pt-3 border-t border-slate-100 flex items-center justify-between gap-2">
      <a
        href={withBase(`/product/${product.slug}/`)}
        class="inline-flex items-center text-xs font-semibold text-brand-navy hover:text-brand-blue transition-colors py-1"
      >
        <span>View Details</span>
        <svg class="w-3.5 h-3.5 ml-1 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <a
        href={telegramLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded text-xs font-medium bg-sky-50 text-brand-telegram hover:bg-sky-100 transition-colors"
        title="Inquire about this product on Telegram"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.37.74-.56 2.92-1.27 4.86-2.11 5.83-2.52 2.77-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24-.01.44z"/>
        </svg>
        <span>Enquire</span>
      </a>
    </div>
  </div>
</div>
