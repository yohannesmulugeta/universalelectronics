---
import { withBase } from '../lib/paths';
import type { Product } from '../types';

interface Props { product: Product; }
const { product } = Astro.props;
const image = product.media?.[0];
---

<article class="product-card group">
  <a href={withBase(`/product/${product.slug}/`)} class="product-card-image" aria-label={`View ${product.title}`}>
    {image ? (
      <img src={withBase(image)} alt={product.title} loading="lazy" decoding="async" width="520" height="560" />
    ) : (
      <span class="flex flex-col items-center justify-center gap-3 px-6 text-center text-brand-muted" role="img" aria-label={`Image for ${product.title} is pending verification`}>
        <svg viewBox="0 0 48 48" width="52" height="52" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="7" y="12" width="34" height="26" rx="3" /><circle cx="17" cy="21" r="3" /><path d="m10 34 10-9 7 6 6-5 6 7" /><path d="M15 7h18" /></svg>
        <span class="text-xs font-medium">Product photo pending verification</span>
      </span>
    )}
  </a>
  <p class="product-card-meta">{product.primaryBrand} <span class="mx-2 text-brand-border">/</span> {product.categoryName}</p>
  <h3 class="product-card-title"><a href={withBase(`/product/${product.slug}/`)}>{product.title}</a></h3>
  <a href={withBase(`/product/${product.slug}/`)} class="product-card-link">View product <span aria-hidden="true">↗</span></a>
</article>
