---
import { withBase } from '../lib/paths';
import type { Product } from '../types';

interface Props { product: Product; }
const { product } = Astro.props;
const image = product.media?.[0];
---

<article class="product-card group">
  <a href={withBase(`/product/${product.slug}/`)} class="product-card-image" aria-label={`View ${product.title}`}>
    {image ? (
      <img src={withBase(image)} alt="" loading="lazy" width="520" height="560" />
    ) : (
      <span class="px-6 text-center text-sm text-brand-muted">Product image unavailable</span>
    )}
  </a>
  <p class="product-card-meta">{product.primaryBrand} <span class="mx-2 text-brand-border">/</span> {product.categoryName}</p>
  <h3 class="product-card-title"><a href={withBase(`/product/${product.slug}/`)}>{product.title}</a></h3>
  <a href={withBase(`/product/${product.slug}/`)} class="product-card-link">View product <span aria-hidden="true">↗</span></a>
</article>
