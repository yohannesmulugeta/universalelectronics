---
import { brands } from '../data/taxonomy';
import { products } from '../data/products';
import { withBase } from '../lib/paths';
import { responsiveImage } from '../lib/responsiveImage';

interface Props { section?: 'all' | 'solar' | 'sound'; }
const { section = 'all' } = Astro.props;
const productBrands = new Set(products.filter((product) => section === 'all' || product.section === section).map((product) => product.primaryBrand));
const listedBrands = brands.filter(
  (brand) => brand.name !== 'Universal Electronics' && productBrands.has(brand.name)
);
const catalogBrands = [
  ...listedBrands.filter((brand) => brand.logoUrl),
  ...listedBrands.filter((brand) => !brand.logoUrl),
];
---

<section class="border-y border-brand-border bg-white py-16 sm:py-20" aria-labelledby="catalog-brands-heading">
  <div class="max-w-site mx-auto px-5 text-center sm:px-8">
    <p class="section-eyebrow mb-4">From our product range</p>
    <h2 id="catalog-brands-heading" class="section-heading">{section === 'all' ? 'Explore brands in our catalog' : section === 'solar' ? 'Explore solar brands' : 'Explore sound brands'}</h2>
    <p class="mx-auto mt-4 max-w-xl text-sm leading-7 text-brand-muted">
      Browse by brand. Select any logo or name to view matching products.
    </p>
  </div>

  <div class="brand-marquee-window mt-10 bg-brand-pale py-5 sm:mt-12 sm:py-7" role="region" aria-label="Scrolling product brands">
    <div class="brand-marquee-track">
      {[false, true].map((duplicate) => (
        <ul class="brand-marquee-group" aria-hidden={duplicate ? 'true' : undefined}>
          {catalogBrands.map((brand) => (
            <li class="brand-marquee-item">
              <a href={withBase(`/shop/?brand=${encodeURIComponent(brand.name)}${section === "all" ? "" : `&section=${section}`}`)} class="brand-marquee-link" tabindex={duplicate ? -1 : undefined} aria-label={`View ${brand.name} products`}>
              {brand.logoUrl ? (
                <img
                  class={`brand-marquee-logo brand-marquee-logo--${brand.slug}`}
                  src={responsiveImage(brand.logoUrl, 200).src}
                  srcset={responsiveImage(brand.logoUrl, 200).srcSet}
                  sizes="150px"
                  alt={duplicate ? '' : brand.name}
                  width="160"
                  height="64"
                  loading="lazy" decoding="async"
                />
              ) : (
                <span class="brand-marquee-name">{brand.name}</span>
              )}
              </a>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>
