---
/**
 * Consistent, product-specific line icons for the homepage quick categories.
 * All shapes use a single 24x24 stroke system, with no icon font / JS dependency.
 */
type ProductIcon = 'solar-panel' | 'inverter' | 'battery' | 'water-pump' | 'speaker' | 'amplifier' | 'microphone' | 'mixer';
interface Props { name: ProductIcon; }
const { name } = Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24"
  fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
  stroke-linejoin="round" focusable="false" aria-hidden="true">
  {name === 'solar-panel' && <g>
    <rect x="2.5" y="9" width="19" height="10.5" rx="1.3" />
    <path d="M9 9v10.5M15 9v10.5M2.5 14.2h19M12 2.3v2.2M5.3 4.2l1.6 1.6M18.7 4.2l-1.6 1.6" />
  </g>}
  {name === 'inverter' && <g>
    <rect x="5" y="2.5" width="14" height="19" rx="2" />
    <circle cx="12" cy="9" r="3" />
    <path d="M8.5 16.5h7M8.5 19h2.5" />
    <path d="M10 9c.8-1.4 1.4-1.4 2 0s1.2 1.4 2 0" stroke-width="1.25" />
  </g>}
  {name === 'battery' && <g>
    <rect x="3" y="6" width="18" height="14.5" rx="2" />
    <path d="M9.5 3.5h5v2.5M13.2 9.2l-3.5 5h3l-1.3 3.4 3.8-5h-3z" />
  </g>}
  {name === 'water-pump' && <g>
    <circle cx="9" cy="13" r="5.8" />
    <circle cx="9" cy="13" r="2" />
    <path d="M9 7.2V4.5h6.5v3.2H21v5.2h-3.5M4.5 17l-1.4 3.8h11.8L13.5 17M19.2 17.7l1.3 2.8" />
  </g>}
  {name === 'speaker' && <g>
    <rect x="5" y="2.5" width="14" height="19" rx="2" />
    <circle cx="12" cy="14.2" r="4.2" />
    <circle cx="12" cy="6.5" r="1.25" />
    <circle cx="12" cy="14.2" r="1.1" />
  </g>}
  {name === 'amplifier' && <g>
    <rect x="2.5" y="5" width="19" height="14" rx="2" />
    <path d="M2.5 9h19M5.5 15.8h5M5.5 13h3" />
    <circle cx="15.5" cy="14.2" r="2.3" />
    <circle cx="19.3" cy="8" r=".65" fill="currentColor" stroke="none" />
  </g>}
  {name === 'microphone' && <g>
    <rect x="9" y="2.5" width="6" height="12" rx="3" />
    <path d="M6 11a6 6 0 0 0 12 0M12 17v4.5M8.5 21.5h7" />
  </g>}
  {name === 'mixer' && <g>
    <path d="M6 3v18M12 3v18M18 3v18" />
    <rect x="4" y="7.2" width="4" height="4.8" rx=".8" fill="white" stroke="currentColor" />
    <rect x="10" y="13.5" width="4" height="4.8" rx=".8" fill="white" stroke="currentColor" />
    <rect x="16" y="5.3" width="4" height="4.8" rx=".8" fill="white" stroke="currentColor" />
  </g>}
</svg>
