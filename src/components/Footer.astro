---
import { withBase } from '../lib/paths';
import { siteConfig } from '../data/siteConfig';

const currentYear = new Date().getFullYear();
---

<footer class="bg-brand-navy text-white mt-auto border-t-4 border-brand-blue">
  <!-- Main Footer Content -->
  <div class="max-w-site mx-auto px-4 sm:px-6 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-10">
      <!-- Col 1: Brand Info (Spans 2 cols on LG) -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="bg-white p-1.5 rounded">
            <img
              src={withBase('/assets/brand/ref-52939cff-cropped-logo-uni.png')}
              alt="Universal Electronics logo"
              class="h-14 w-auto object-contain"
              width="150"
              height="45"
              loading="lazy"
            />
          </div>
        </div>

        <p class="text-slate-300 text-sm leading-relaxed max-w-sm">
          Solar equipment and professional sound systems in Addis Ababa. Explore our catalog and get in touch to discuss your requirements.
        </p>

      </div>

      <!-- Col 2: Solar Categories -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-sky-400 mb-3">
          Solar Solutions
        </h3>
        <ul class="space-y-2 text-sm text-slate-300">
          {
            siteConfig.solarCategories.map((cat) => (
              <li>
                <a
                  href={withBase(`/category/${cat.slug}/`)}
                  class="hover:text-white transition-colors block py-0.5"
                >
                  {cat.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 3: Sound Categories -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-sky-400 mb-3">
          Sound Equipment
        </h3>
        <ul class="space-y-2 text-sm text-slate-300">
          {
            siteConfig.soundCategories.map((cat) => (
              <li>
                <a
                  href={withBase(`/category/${cat.slug}/`)}
                  class="hover:text-white transition-colors block py-0.5"
                >
                  {cat.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 4: Contact & Channels -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-sky-400 mb-3">
          Contact Details
        </h3>
        <div class="space-y-2.5 text-sm text-slate-300">
          <p class="flex items-start gap-2">
            <span class="text-sky-400 shrink-0 mt-0.5" aria-hidden="true">—</span>
            <span>{siteConfig.address}, {siteConfig.city}, {siteConfig.country}</span>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-sky-400 shrink-0" aria-hidden="true">—</span>
            <a href={`tel:${siteConfig.phones[0].replace(/\s+/g, '')}`} class="hover:text-white transition-colors">
              {siteConfig.phones[0]}
            </a>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-sky-400 shrink-0" aria-hidden="true">—</span>
            <span>{siteConfig.phones[1]}</span>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-sky-400 shrink-0" aria-hidden="true">—</span>
            <a href={`mailto:${siteConfig.email}`} class="hover:text-white transition-colors break-all">
              {siteConfig.email}
            </a>
          </p>
          <div class="pt-2">
            <a
              href={siteConfig.telegramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-brand-telegram text-white text-xs font-medium hover:bg-brand-telegramHover transition-colors"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.37.74-.56 2.92-1.27 4.86-2.11 5.83-2.52 2.77-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24-.01.44z"/>
              </svg>
              <span>Telegram Channel</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-6 border-t border-slate-700/60 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-400">
      <p>© {currentYear} Universal Electronics. All rights reserved.</p>
      <div class="flex items-center space-x-4">
        <a href={withBase('/')} class="hover:text-slate-300">Home</a>
        <span>•</span>
        <a href={withBase('/shop/')} class="hover:text-slate-300">Product Catalog</a>
        <span>•</span>
        <a href={withBase('/projects/')} class="hover:text-slate-300">Projects</a>
        <span>•</span>
        <a href={withBase('/recognition/')} class="hover:text-slate-300">Recognition</a>
        <span>•</span>
        <a href={withBase('/contact/')} class="hover:text-slate-300">Contact Us</a>
      </div>
    </div>
  </div>
</footer>
