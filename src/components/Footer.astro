---
import { withBase } from '../lib/paths';
import { siteConfig } from '../data/siteConfig';
const year = new Date().getFullYear();
---

<footer class="mt-auto bg-brand-navy text-white">
  <div class="max-w-site mx-auto px-5 py-16 sm:px-8 lg:py-24">
    <div class="grid gap-12 border-b border-white/20 pb-16 lg:grid-cols-[2fr_1fr_1fr_1.4fr]">
      <div>
        <div class="inline-block bg-[#faf9f6] p-2"><img src={withBase('/assets/brand/ref-52939cff-cropped-logo-uni.png')} alt="Universal Electronics" class="h-12 w-auto" width="150" height="58" loading="lazy" /></div>
        <p class="mt-7 max-w-sm text-sm leading-7 text-[#c4cecb]">Solar energy equipment and professional sound products in Addis Ababa, Ethiopia.</p>
      </div>
      <div>
        <h2 class="mb-5 text-xs font-bold uppercase tracking-[.16em] text-[#b3c9c9]">Explore</h2>
        <ul class="space-y-3 text-sm text-white/85">
          <li><a class="hover:text-white hover:underline" href={withBase('/shop/solar/')}>Solar equipment</a></li>
          <li><a class="hover:text-white hover:underline" href={withBase('/shop/sound/')}>Professional sound</a></li>
          <li><a class="hover:text-white hover:underline" href={withBase('/shop/')}>All products</a></li>
        </ul>
      </div>
      <div>
        <h2 class="mb-5 text-xs font-bold uppercase tracking-[.16em] text-[#b3c9c9]">Company</h2>
        <ul class="space-y-3 text-sm text-white/85">
          <li><a class="hover:text-white hover:underline" href={withBase('/about/')}>About</a></li>
          <li><a class="hover:text-white hover:underline" href={withBase('/projects/')}>Projects</a></li>
          <li><a class="hover:text-white hover:underline" href={withBase('/recognition/')}>Recognition</a></li>
          <li><a class="hover:text-white hover:underline" href={withBase('/contact/')}>Contact</a></li>
        </ul>
      </div>
      <div>
        <h2 class="mb-5 text-xs font-bold uppercase tracking-[.16em] text-[#b3c9c9]">Get in touch</h2>
        <address class="space-y-3 text-sm leading-6 text-white/85 not-italic">
          <p>{siteConfig.address}<br />{siteConfig.city}, {siteConfig.country}</p>
          <p><a class="hover:text-white hover:underline" href={`tel:${siteConfig.phones[0].replace(/\s+/g, '')}`}>{siteConfig.phones[0]}</a></p>
          <p><a class="break-all hover:text-white hover:underline" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>
          <p><a class="hover:text-white hover:underline" href={siteConfig.telegramUrl} target="_blank" rel="noopener noreferrer">Telegram ↗</a></p>
        </address>
      </div>
    </div>
    <div class="flex flex-col justify-between gap-3 pt-7 text-xs text-[#b3c0be] sm:flex-row">
      <p>© {year} Universal Electronics. All rights reserved.</p>
      <p>Addis Ababa, Ethiopia</p>
    </div>
  </div>
</footer>
