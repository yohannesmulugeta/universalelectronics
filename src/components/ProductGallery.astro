---
import { withBase } from '../lib/paths';
interface Props { title: string; media: string[]; }
const { title, media } = Astro.props;
const primary = media?.[0];
---
<div class="space-y-4" data-product-gallery>
  <div class="relative flex aspect-square items-center justify-center overflow-hidden bg-brand-offwhite p-6 sm:p-10">
    {primary ? (
      <img data-gallery-main src={withBase(primary)} alt={title} loading="eager" decoding="async" class="h-full w-full max-h-[520px] object-contain" />
    ) : (
      <div class="flex flex-col items-center gap-3 px-5 text-center text-brand-muted">
        <svg viewBox="0 0 48 48" class="h-14 w-14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="7" y="12" width="34" height="26" rx="3" /><circle cx="17" cy="21" r="3" /><path d="m10 34 10-9 7 6 6-5 6 7" /></svg>
        <p class="font-semibold">Product image awaiting verification</p>
        <p class="text-sm">Ask our team for a photo of the exact model and variant.</p>
      </div>
    )}
  </div>
  {primary && (
    <a data-gallery-full href={withBase(primary)} target="_blank" rel="noopener noreferrer" class="text-link">View original product photo ↗</a>
  )}
  {media.length > 1 && (
    <div class="flex gap-3 overflow-x-auto pb-2" role="group" aria-label={`Photos of ${title}`}>
      {media.map((file, i) => (
        <button type="button" data-gallery-choice data-photo={withBase(file)} data-alt={`${title}, photo ${i+1}`} aria-label={`View photo ${i + 1} of ${media.length}`} aria-pressed={i === 0 ? 'true' : 'false'} class="h-20 w-20 shrink-0 border-2 border-brand-border bg-brand-offwhite p-2 aria-pressed:border-brand-blue focus-visible:outline-2 focus-visible:outline-brand-blue">
          <img src={withBase(file)} alt="" loading="lazy" class="h-full w-full object-contain" />
        </button>
      ))}
    </div>
  )}
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-product-gallery]').forEach((gallery) => {
    const main = gallery.querySelector<HTMLImageElement>('[data-gallery-main]');
    const full = gallery.querySelector<HTMLAnchorElement>('[data-gallery-full]');
    gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-choice]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!main) return;
        const url = button.dataset.photo;
        if (!url) return;
        main.src = url;
        main.alt = button.dataset.alt || main.alt;
        if (full) full.href = url;
        gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-choice]').forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
      });
    });
  });
</script>
