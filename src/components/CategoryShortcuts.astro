---
import { withBase } from '../lib/paths';
import CategoryIcon from './CategoryIcon.astro';
const categories=[
 {name:'Solar Panels',slug:'solar-panels',icon:'solar-panel'},
 {name:'Inverters',slug:'inverters',icon:'inverter'},
 {name:'Batteries',slug:'solar-batteries',icon:'battery'},
 {name:'Water Pumps',slug:'solar-water-pumps',icon:'water-pump'},
 {name:'Speakers',slug:'speakers',icon:'speaker'},
 {name:'Amplifiers',slug:'amplifiers',icon:'amplifier'},
 {name:'Microphones',slug:'microphones',icon:'microphone'},
 {name:'Mixers',slug:'mixer',icon:'mixer'}
] as const
---
<section class="border-b border-brand-border bg-white" aria-labelledby="quick-categories-title">
 <div class="max-w-site mx-auto px-5 py-12 sm:px-8 lg:py-16">
  <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
   <div><p class="section-eyebrow mb-3">Quick access</p><h2 id="quick-categories-title" class="font-serif text-2xl font-bold text-brand-navy sm:text-3xl">Explore by product type.</h2></div>
   <a class="text-link" href={withBase('/shop/')}>All products ↗</a>
  </div>
  <div class="ue-category-quick-grid">
   {categories.map((category)=>(
    <a class="ue-category-quick" href={withBase('/category/'+category.slug+'/')}>
     <span class="ue-category-symbol" aria-hidden="true" data-category-icon={category.icon}><CategoryIcon name={category.icon} /></span>
     <span class="ue-category-name">{category.name}</span>
     <span class="ue-category-go" aria-hidden="true">↗</span>
    </a>
   ))}
  </div>
 </div>
</section>
