---
import { withBase } from '../lib/paths';
import type { Product } from '../types';

interface Props { items: Product[]; }
const { items } = Astro.props;
---

<section class="featured-carousel bg-white py-20 lg:py-28" aria-labelledby="featured-heading" data-featured-carousel>
  <div class="max-w-site mx-auto px-5 text-center sm:px-8">
    <p class="section-eyebrow mb-4">Selected from the catalog</p>
    <h2 id="featured-heading" class="font-serif text-2xl font-semibold text-brand-navy sm:text-3xl">Explore selected products</h2>
  </div>

  <div id="featured-carousel-track" class="featured-carousel-track mt-10" tabindex="0" role="region" aria-label="Selected product carousel">
    {items.map((product) => (
      <article class="featured-carousel-card">
        <a href={withBase(`/product/${product.slug}/`)} class="featured-carousel-image" aria-label={`View ${product.title}`}>
          {product.media?.[0] ? (
            <img src={withBase(product.media[0])} alt="" width="360" height="360" loading="lazy" />
          ) : (
            <span class="text-sm text-brand-muted">Product image unavailable</span>
          )}
        </a>
        <div class="featured-carousel-copy">
          <p class="text-[11px] font-semibold uppercase tracking-[.13em] text-brand-blue">{product.primaryBrand}</p>
          <h3 class="mt-2 font-serif text-sm font-semibold leading-snug text-brand-navy sm:text-base">
            <a href={withBase(`/product/${product.slug}/`)}>{product.title}</a>
          </h3>
        </div>
      </article>
    ))}
  </div>

  <div class="max-w-site mx-auto flex items-center justify-between gap-5 px-5 pt-7 sm:px-8">
    <a href={withBase('/shop/')} class="text-link">View all products <span aria-hidden="true">↗</span></a>
    <div class="flex items-center gap-4 sm:gap-6">
      <div class="featured-carousel-progress hidden sm:block" aria-hidden="true"><span data-carousel-progress></span></div>
      <button type="button" data-carousel-prev class="featured-carousel-control" aria-label="Previous products" aria-controls="featured-carousel-track">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 5-7 7 7 7M7 12h13" /></svg>
      </button>
      <button type="button" data-carousel-next class="featured-carousel-control" aria-label="Next products" aria-controls="featured-carousel-track">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m10 5 7 7-7 7M17 12H4" /></svg>
      </button>
      <button type="button" data-carousel-play class="featured-carousel-control" aria-label="Pause automatic scrolling" aria-controls="featured-carousel-track">
        <svg data-pause-icon viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="3" height="14" rx=".5" /><rect x="15" y="5" width="3" height="14" rx=".5" /></svg>
        <svg data-play-icon class="hidden" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.8a1 1 0 0 1 1.5-.86l9 6.2a1 1 0 0 1 0 1.72l-9 6.2A1 1 0 0 1 8 18.2V5.8Z" /></svg>
      </button>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-featured-carousel]');
  const track = root?.querySelector<HTMLElement>('.featured-carousel-track');
  const progress = root?.querySelector<HTMLElement>('[data-carousel-progress]');
  const prev = root?.querySelector<HTMLButtonElement>('[data-carousel-prev]');
  const next = root?.querySelector<HTMLButtonElement>('[data-carousel-next]');
  const play = root?.querySelector<HTMLButtonElement>('[data-carousel-play]');
  const pauseIcon = root?.querySelector<HTMLElement>('[data-pause-icon]');
  const playIcon = root?.querySelector<HTMLElement>('[data-play-icon]');

  if (root && track && progress && prev && next && play && pauseIcon && playIcon) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cards = [...track.querySelectorAll<HTMLElement>('.featured-carousel-card')];
    let playing = !reduceMotion;
    let focused = false;
    let hovered = false;
    let interacting = false;
    let manualBusy = false;
    let visible = false;
    let loopWidth = 0;
    let frame: number | undefined;
    let lastFrame = 0;
    let manualTimer: number | undefined;

    const cardStep = () => cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth;
    const canAnimate = () => playing && visible && !focused && !hovered && !interacting && !manualBusy && !document.hidden && loopWidth > 0;
    const updateProgress = () => {
      const fraction = loopWidth ? Math.min(0.26, Math.max(0.12, track.clientWidth / loopWidth)) : 0.26;
      const position = loopWidth ? (track.scrollLeft % loopWidth) / loopWidth : 0;
      progress.style.width = `${fraction * 100}%`;
      progress.style.left = `${position * (1 - fraction) * 100}%`;
    };
    const animate = (time: number) => {
      if (!canAnimate()) { frame = undefined; lastFrame = 0; return; }
      if (lastFrame) {
        track.scrollLeft += Math.min(time - lastFrame, 64) * 0.045;
        if (track.scrollLeft >= loopWidth) track.scrollLeft %= loopWidth;
      }
      lastFrame = time;
      updateProgress();
      frame = window.requestAnimationFrame(animate);
    };
    const syncAnimation = () => {
      if (canAnimate() && frame === undefined) {
        lastFrame = 0;
        frame = window.requestAnimationFrame(animate);
      } else if (!canAnimate() && frame !== undefined) {
        window.cancelAnimationFrame(frame);
        frame = undefined;
        lastFrame = 0;
      }
    };
    const refreshLayout = () => {
      loopWidth = cards.length * cardStep();
      while (loopWidth > 0 && track.scrollWidth - track.clientWidth <= loopWidth && cards.length) {
        cards.forEach((card) => {
          const clone = card.cloneNode(true) as HTMLElement;
          clone.setAttribute('aria-hidden', 'true');
          clone.setAttribute('inert', '');
          clone.querySelectorAll('a').forEach((link) => { link.tabIndex = -1; });
          track.appendChild(clone);
        });
      }
      if (loopWidth && track.scrollLeft >= loopWidth) track.scrollLeft %= loopWidth;
      updateProgress();
      syncAnimation();
    };
    const move = (direction: 1 | -1) => {
      manualBusy = true;
      syncAnimation();
      let start = track.scrollLeft;
      if (start >= loopWidth) start %= loopWidth;
      if (direction === -1 && start < cardStep()) start += loopWidth;
      track.scrollLeft = start;
      track.scrollTo({ left: start + direction * cardStep(), behavior: reduceMotion ? 'instant' : 'smooth' });
      window.clearTimeout(manualTimer);
      manualTimer = window.setTimeout(() => { manualBusy = false; syncAnimation(); }, 700);
    };
    const syncPlayButton = () => {
      play.setAttribute('aria-label', playing ? 'Pause automatic scrolling' : 'Resume automatic scrolling');
      pauseIcon.classList.toggle('hidden', !playing);
      playIcon.classList.toggle('hidden', playing);
    };

    prev.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    play.addEventListener('click', () => {
      playing = !playing;
      if (playing) focused = false;
      syncPlayButton();
      syncAnimation();
    });
    root.addEventListener('focusin', () => { focused = true; syncAnimation(); });
    root.addEventListener('focusout', (event) => {
      if (!root.contains(event.relatedTarget as Node | null)) { focused = false; syncAnimation(); }
    });
    track.addEventListener('pointerdown', () => { interacting = true; syncAnimation(); });
    track.addEventListener('pointerenter', () => { hovered = true; syncAnimation(); });
    track.addEventListener('pointerleave', () => { hovered = false; syncAnimation(); });
    const endInteraction = () => {
      if (!interacting) return;
      interacting = false;
      manualBusy = true;
      window.clearTimeout(manualTimer);
      manualTimer = window.setTimeout(() => { manualBusy = false; syncAnimation(); }, 700);
    };
    window.addEventListener('pointerup', endInteraction);
    window.addEventListener('pointercancel', endInteraction);
    track.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', refreshLayout);
    document.addEventListener('visibilitychange', syncAnimation);
    const observer = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; syncAnimation(); }, { threshold: 0.1 });
    observer.observe(root);
    syncPlayButton();
    refreshLayout();
  }
</script>
