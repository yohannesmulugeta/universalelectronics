---
import { withBase } from '../lib/paths';
import { siteConfig } from '../data/siteConfig';

const currentPath = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, '').length) || '/';

function isActive(href: string) {
  if (href === '/') {
    return currentPath === '/' || currentPath === '';
  }
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-40 bg-white/92 backdrop-blur-xl border-b border-slate-200/80">
  <div class="max-w-site mx-auto px-4 sm:px-6 h-[74px] flex items-center justify-between gap-5">
    <a href={withBase('/')} class="flex items-center shrink-0" aria-label="Universal Electronics Home">
      <img
        src={withBase('/assets/brand/ref-52939cff-cropped-logo-uni.png')}
        alt="Universal Electronics"
        class="h-11 sm:h-12 w-auto object-contain"
        width="117"
        height="56"
        loading="eager"
      />
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label="Primary Navigation">
      {
        siteConfig.navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={withBase(link.href)}
              class={`nav-link px-3 py-2 text-[13px] font-semibold transition-colors ${
                active
                  ? 'text-brand-navy is-active'
                  : 'text-slate-600 hover:text-brand-navy'
              }`}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <div class="hidden lg:flex items-center gap-2 shrink-0">
      <a
        href={`tel:${siteConfig.phones[0].replace(/\s+/g, '')}`}
        class="px-3 py-2 text-[13px] font-semibold text-slate-600 hover:text-brand-navy transition-colors"
      >
        {siteConfig.phones[0]}
      </a>
      <a
        href={withBase('/contact/')}
        class="inline-flex items-center gap-2 bg-brand-navy text-white px-4 py-2.5 text-[13px] font-semibold hover:bg-brand-blue transition-colors"
      >
        <span>Talk to us</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>

    <button
      id="mobile-menu-toggle"
      type="button"
      class="lg:hidden inline-flex items-center justify-center w-10 h-10 border border-slate-200 text-brand-navy hover:bg-slate-50 transition-colors"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Toggle mobile navigation menu"
    >
      <svg id="menu-icon-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white">
    <div class="px-4 py-5">
      <nav class="grid grid-cols-2 gap-px bg-slate-200 border border-slate-200" aria-label="Mobile Navigation">
        {
          siteConfig.navLinks.map((link) => {
            const active = isActive(link.href);
            return (
              <a
                href={withBase(link.href)}
                class={`px-4 py-4 bg-white text-sm font-semibold transition-colors ${
                  active ? 'text-brand-blue' : 'text-brand-navy hover:text-brand-blue'
                }`}
              >
                {link.label}
              </a>
            );
          })
        }
      </nav>

      <div class="grid grid-cols-2 gap-2 mt-3">
        <a
          href={`https://wa.me/${siteConfig.whatsappNumber}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-4 py-3 bg-brand-blue text-white text-sm font-semibold"
        >
          WhatsApp
        </a>
        <a
          href={`tel:${siteConfig.phones[0].replace(/\s+/g, '')}`}
          class="inline-flex items-center justify-center px-4 py-3 border border-slate-300 text-brand-navy text-sm font-semibold"
        >
          Call us
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');

  if (toggleBtn && menu && openIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });
  }
</script>
