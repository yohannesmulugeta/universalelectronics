---
import { withBase } from '../lib/paths';
import { siteConfig } from '../data/siteConfig';

const currentPath = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, '').length) || '/';

function isActive(href: string) {
  if (href === '/') {
    return currentPath === '/' || currentPath === '';
  }
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-brand-border/80">
  <!-- Top Utility Bar -->
  <div class="bg-brand-navy text-white text-xs py-2 px-4 border-b border-white/10 hidden sm:block">
    <div class="max-w-site mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-6">
        <span class="flex items-center space-x-1.5 text-white/90">
          <svg class="w-3.5 h-3.5 text-brand-pale" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>{siteConfig.address}, {siteConfig.city}</span>
        </span>
        <a href={`mailto:${siteConfig.email}`} class="flex items-center space-x-1.5 text-white/90 hover:text-white transition-colors">
          <svg class="w-3.5 h-3.5 text-brand-pale" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>{siteConfig.email}</span>
        </a>
      </div>

      <div class="flex items-center space-x-4">
        <a href={`tel:${siteConfig.phones[0].replace(/\s+/g, '')}`} class="flex items-center space-x-1.5 text-white/90 hover:text-white transition-colors">
          <svg class="w-3.5 h-3.5 text-brand-pale" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span class="font-medium">{siteConfig.phones[0]}</span>
        </a>
        <span class="text-white/30">|</span>
        <a
          href={siteConfig.telegramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center space-x-1 text-sky-300 hover:text-white transition-colors"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.37.74-.56 2.92-1.27 4.86-2.11 5.83-2.52 2.77-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24-.01.44z"/>
          </svg>
          <span>Telegram</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-site mx-auto px-4 sm:px-6 py-2.5 sm:py-3 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href={withBase('/')} class="flex items-center gap-3 focus:outline-none" aria-label="Universal Electronics Home">
      <img
        src={withBase('/assets/brand/ref-52939cff-cropped-logo-uni.png')}
        alt="Universal Electronics logo"
        class="h-12 sm:h-14 w-auto object-contain"
        width="117"
        height="56"
        loading="eager"
      />
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center space-x-1" aria-label="Primary Navigation">
      {
        siteConfig.navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={withBase(link.href)}
              class={`nav-link px-3 py-2 text-sm font-medium transition-colors ${
                active
                  ? 'text-brand-navy font-semibold is-active'
                  : 'text-brand-dark hover:text-brand-blue'
              }`}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Header Action Button (Desktop) -->
    <div class="hidden lg:flex items-center space-x-3">
      <a
        href={`https://wa.me/${siteConfig.whatsappNumber}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-md bg-brand-blue text-white text-sm font-medium hover:bg-brand-blueHover shadow-sm transition-colors"
      >
        <span>WhatsApp us</span>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <div class="flex lg:hidden items-center">
      <button
        id="mobile-menu-toggle"
        type="button"
        class="p-2 rounded-md text-brand-dark hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-blue"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Toggle mobile navigation menu"
      >
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-brand-border bg-white px-4 pt-3 pb-6">
    <nav class="flex flex-col space-y-1" aria-label="Mobile Navigation">
      {
        siteConfig.navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={withBase(link.href)}
              class={`px-3 py-2.5 text-base font-medium rounded-md transition-colors ${
                active
                  ? 'text-brand-navy bg-brand-pale font-semibold'
                  : 'text-brand-dark hover:text-brand-blue hover:bg-slate-50'
              }`}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <div class="mt-4 pt-4 border-t border-slate-100 flex flex-col gap-2">
      <a
        href={siteConfig.telegramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-md bg-brand-blue text-white font-medium text-sm shadow-sm"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.37.74-.56 2.92-1.27 4.86-2.11 5.83-2.52 2.77-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24-.01.44z"/>
        </svg>
        <span>Message on Telegram</span>
      </a>

      <a
        href={`tel:${siteConfig.phones[0].replace(/\s+/g, '')}`}
        class="w-full flex items-center justify-center gap-2 px-4 py-2 rounded-md border border-brand-border text-brand-dark font-medium text-sm hover:bg-slate-50"
      >
        <svg class="w-4 h-4 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>Call: {siteConfig.phones[0]}</span>
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');

  if (toggleBtn && menu && openIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });
  }
</script>
