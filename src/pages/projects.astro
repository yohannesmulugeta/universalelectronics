---
import { withBase } from '../lib/paths';
import { responsiveImage } from '../lib/responsiveImage';
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { projects } from '../data/projects';
import { siteConfig } from '../data/siteConfig';
---

<Layout title="Featured Projects & Installations | Universal Electronics"
  description="Explore solar energy, water pumping, and engineering projects from the Universal Electronics archive.">
  <div class="max-w-site mx-auto px-4 sm:px-6 py-6 sm:py-8">
    <Breadcrumb items={[{ label: 'Projects' }]} />
    <section class="max-w-3xl py-10 lg:py-16" data-reveal>
      <p class="section-eyebrow mb-5">From our project archive</p>
      <h1 class="font-serif text-4xl sm:text-5xl text-brand-navy leading-tight">Solar & sound installations</h1>
      <p class="mt-6 text-lg leading-relaxed text-slate-600">
        These AI-assisted images recreate scenes from archived field photographs of solar and water-supply installations.
      </p>
    </section>

    <section class="grid md:grid-cols-2 gap-8 mb-20" aria-label="Project installations showcase">
      {projects.map((project) => (
        <article class="group flex flex-col bg-white border border-brand-border rounded-lg overflow-hidden shadow-sm hover:shadow-md hover:border-brand-blue/50 transition-all duration-300">
          <div class="relative aspect-[16/10] overflow-hidden bg-slate-100">
            <img src={responsiveImage(project.image, 960).src} srcset={responsiveImage(project.image,960).srcSet} sizes="(max-width: 768px) 94vw, 48vw" alt={`AI-assisted image based on the original photo of ${project.title}`}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              loading="lazy" width="800" height="500" />
            <span class="absolute top-3 left-3 bg-white/95 backdrop-blur-sm text-brand-navy text-xs font-medium px-2.5 py-1 rounded shadow-sm">
              {project.category}
            </span>
            <span class="absolute top-3 right-3 bg-brand-navy/90 backdrop-blur-sm text-white text-xs font-semibold px-2.5 py-1 rounded shadow-sm">
              {project.badge}
            </span>
          </div>
          <div class="p-6 flex flex-col flex-1">
            <h2 class="font-serif text-xl sm:text-2xl text-brand-navy group-hover:text-brand-blue transition-colors">
              {project.title}
            </h2>
            <div class="flex items-center gap-1.5 text-xs text-slate-500 font-medium mt-1.5 mb-3">
              <svg class="w-3.5 h-3.5 text-brand-blue shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
              </svg>
              <span>{project.location}</span>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed mb-6 flex-1">
              {project.description}
            </p>
            <div class="pt-4 border-t border-slate-100 flex items-center justify-end text-xs font-medium">
              <a href={withBase('/contact/')} class="text-slate-500 hover:text-brand-navy inline-flex items-center gap-1">
                Enquire about similar system <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </section>

    <section class="border-t border-slate-200 py-12 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
      <div>
        <h2 class="font-serif text-2xl text-brand-navy">Planning a solar or audio installation?</h2>
        <p class="text-slate-600 mt-2 max-w-xl">
          Speak directly with our technical team in Addis Ababa about equipment availability, sizing, and turnkey project requirements.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 shrink-0">
        <a href={`https://wa.me/${siteConfig.whatsappNumber}`} target="_blank" rel="noopener noreferrer" class="button-primary">
          WhatsApp enquiry <span aria-hidden="true">↗</span>
        </a>
        <a href={withBase('/contact/')} class="button-secondary">
          Contact details
        </a>
      </div>
    </section>
  </div>
</Layout>
