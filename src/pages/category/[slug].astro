---
import { withBase } from '../../lib/paths';
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProductCard from '../../components/ProductCard.astro';
import { categories } from '../../data/taxonomy';
import { products } from '../../data/products';
import type { Category } from '../../types';

export function getStaticPaths() {
  return categories.map((cat) => ({
    params: { slug: cat.slug },
    props: { category: cat },
  }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
const categoryProducts = products.filter((p) => p.categorySlug === category.slug);

const parentLabel = category.section === 'solar' ? 'Solar Solutions' : 'Sound Equipment';
const parentHref = category.section === 'solar' ? '/shop/solar/' : '/shop/sound/';
---

<Layout
  title={`${category.name} | Universal Electronics`}
  description={category.description}
>
  <div class="max-w-site mx-auto px-5 sm:px-8 py-6 sm:py-8">
    <Breadcrumb
      items={[
        { label: 'Product Catalog', href: '/shop/' },
        { label: parentLabel, href: parentHref },
        { label: category.name },
      ]}
    />

    <!-- Category Header -->
    <div class="mb-14 pb-10 pt-8 border-b border-brand-border/80">
      <div class="flex items-center gap-2 mb-3">
        <a
          href={withBase(parentHref)}
          class="inline-flex items-center gap-1 text-xs font-semibold text-brand-blue hover:text-brand-blueHover"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Back to {parentLabel}</span>
        </a>
      </div>

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-semibold text-brand-navy mb-3">
            {category.name}
          </h1>
          <p class="text-sm sm:text-base text-slate-600 max-w-2xl leading-relaxed">
            {category.description}
          </p>
        </div>

        <div class="shrink-0">
          <span class="inline-flex items-center text-xs font-semibold uppercase tracking-[.12em] text-brand-muted">
            {categoryProducts.length} Published {categoryProducts.length === 1 ? 'Model' : 'Models'}
          </span>
        </div>
      </div>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-12">
      {categoryProducts.map((p) => <ProductCard product={p} />)}
    </div>

    <!-- Bottom Navigation -->
    <div class="mt-14 pt-6 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
      <a
        href={withBase(parentHref)}
        class="inline-flex items-center gap-2 text-sm font-semibold text-brand-navy hover:text-brand-blue transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Explore all {parentLabel}</span>
      </a>

      <a
        href={withBase('/shop/')}
        class="inline-flex items-center gap-2 text-sm font-semibold text-brand-blue hover:text-brand-blueHover transition-colors"
      >
        <span>Browse complete 59-product catalog</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</Layout>
