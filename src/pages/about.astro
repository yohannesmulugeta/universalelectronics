---
import { withBase } from '../lib/paths';
import { responsiveImage } from '../lib/responsiveImage';
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { siteConfig } from '../data/siteConfig';
---

<Layout title="About Universal Electronics"
  description="Learn about Universal Electronics, a solar and sound equipment business based in Addis Ababa, Ethiopia.">
  <div class="max-w-site mx-auto px-5 sm:px-8 py-6 sm:py-8">
    <Breadcrumb items={[{ label: 'About Us' }]} />
    <section class="grid lg:grid-cols-[1.05fr_.95fr] gap-10 lg:gap-16 items-center py-14 lg:py-24">
      <div data-reveal>
        <p class="section-eyebrow mb-5">About Universal Electronics</p>
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-semibold leading-tight text-brand-navy">Equipment for power and sound.</h1>
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-slate-600">
          Based in Addis Ababa, Universal Electronics brings together solar energy equipment and professional sound products. Our catalog covers products for homes, businesses and project work.
        </p>
        <div class="flex flex-wrap gap-5 mt-9">
          <a href={withBase('/shop/')} class="button-primary">Browse products <span aria-hidden="true">↗</span></a>
          <a href={withBase('/contact/')} class="text-link">Contact us <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="bg-brand-offwhite aspect-[4/3] overflow-hidden" data-reveal>
        <img src={responsiveImage('/assets/projects/recreated-array-assembly.webp', 960).src} srcset={responsiveImage('/assets/projects/recreated-array-assembly.webp',960).srcSet} sizes="(max-width: 1024px) 100vw, 50vw" alt="AI-assisted image based on an archived solar panel installation photo"
          class="w-full h-full object-cover" width="1586" height="992" loading="lazy" />
      </div>
    </section>

    <section class="grid md:grid-cols-2 gap-12 border-t border-slate-200 py-16 lg:py-20">
      <div data-reveal>
        <p class="section-eyebrow mb-4">01 / Solar</p>
        <h2 class="font-serif text-3xl text-brand-navy">Solar equipment</h2>
        <p class="mt-4 leading-relaxed text-slate-600">Our catalog includes panels, inverters, batteries, pumps and portable lights.</p>
        <a href={withBase('/shop/solar/')} class="text-link mt-6">Explore solar <span aria-hidden="true">↗</span></a>
      </div>
      <div data-reveal>
        <p class="section-eyebrow mb-4">02 / Sound</p>
        <h2 class="font-serif text-3xl text-brand-navy">Sound equipment</h2>
        <p class="mt-4 leading-relaxed text-slate-600">Find speakers, amplifiers, microphones, mixers and instruments in the sound catalog.</p>
        <a href={withBase('/shop/sound/')} class="text-link mt-6">Explore sound <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="grid gap-6 border-t border-brand-border py-14 lg:grid-cols-3 lg:py-20" aria-labelledby="work-approach">
      <div class="lg:col-span-3"><p class="section-eyebrow mb-4">How to get started</p><h2 id="work-approach" class="section-heading max-w-3xl">From enquiry to the right product.</h2></div>
      <div class="border-t-2 border-brand-blue pt-5"><p class="section-eyebrow">01 · Explore</p><h3 class="mt-3 font-serif text-xl font-semibold text-brand-navy">Browse the range</h3><p class="mt-3 text-sm leading-7 text-brand-muted">Compare the solar and professional sound products in our catalog.</p></div>
      <div class="border-t-2 border-brand-blue pt-5"><p class="section-eyebrow">02 · Ask</p><h3 class="mt-3 font-serif text-xl font-semibold text-brand-navy">Share your requirements</h3><p class="mt-3 text-sm leading-7 text-brand-muted">Tell us what you want to power, where it will be used or what type of sound system you need.</p></div>
      <div class="border-t-2 border-brand-blue pt-5"><p class="section-eyebrow">03 · Confirm</p><h3 class="mt-3 font-serif text-xl font-semibold text-brand-navy">Request a quotation</h3><p class="mt-3 text-sm leading-7 text-brand-muted">Confirm available models, specifications and current terms with our team before purchase.</p></div>
    </section>
    <section class="grid items-center gap-6 border-t border-brand-border py-14 lg:grid-cols-[1fr_auto]">
      <div><p class="section-eyebrow mb-3">Archived documents</p><h2 class="font-serif text-2xl font-semibold text-brand-navy sm:text-3xl">Recognition, letters and certificates</h2><p class="mt-3 max-w-xl text-sm leading-7 text-brand-muted">Browse the five original documents preserved from our previous website. Each document can be opened in full.</p></div>
      <a href={withBase('/recognition/')} class="button-secondary">View recognition archive ↗</a>
    </section>
    <section class="bg-brand-offwhite p-8 sm:p-12 lg:p-16 mb-20 grid lg:grid-cols-2 gap-8">
      <div data-reveal>
        <p class="section-eyebrow mb-4">Visit or call</p>
        <h2 class="font-serif text-3xl text-brand-navy">Let's find the right equipment.</h2>
      </div>
      <div class="space-y-4 text-slate-700" data-reveal>
        <p>Tefera Business Center | Habte Giyorgis<br /><span lang="am">{siteConfig.addressAmharic}</span><br />{siteConfig.city}, {siteConfig.country}</p>
        <p><a class="text-link" href={`tel:${siteConfig.phones[0].replace(/\s+/g, '')}`}>{siteConfig.phones[0]}</a></p>
        <a class="button-primary" href={withBase('/contact/')}>All contact details <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</Layout>
