---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { withBase } from '../lib/paths';
import { responsiveImage } from '../lib/responsiveImage';
---
<Layout title="Equipment Solutions & Services | Universal Electronics"
  description="Explore Universal Electronics solar power, energy storage, water-pump and professional audio equipment solutions in Addis Ababa, Ethiopia.">
  <div class="max-w-site mx-auto px-5 py-6 sm:px-8">
    <Breadcrumb items={[{ label: 'Services & Solutions' }]} />
    <section class="grid gap-8 border-b border-brand-border py-12 lg:grid-cols-[1fr_.75fr] lg:items-end lg:py-20">
      <div><p class="section-eyebrow mb-5">What we help you explore</p>
        <h1 class="max-w-4xl font-serif text-4xl font-extrabold leading-tight text-brand-navy sm:text-5xl lg:text-6xl">Solutions for power, water and sound.</h1>
      </div>
      <p class="max-w-md text-base leading-8 text-brand-muted">Start with the equipment you need, then enquire about current availability, exact specifications and a quotation. Installation or technical service scope should be agreed separately with our team.</p>
    </section>

    <section class="grid gap-7 py-12 lg:grid-cols-2 lg:py-20" aria-label="Our solution areas">
      <article class="overflow-hidden border border-brand-border bg-white">
        <div class="flex h-64 items-center justify-center bg-brand-pale p-8"><img src={responsiveImage('/assets/products/inverters/4630-PV19-4-6K-01.jpg',960).src} alt="Solar inverter" width="600" height="420" class="h-full w-full object-contain" loading="lazy" /></div>
        <div class="p-7 sm:p-9"><p class="section-eyebrow">01 / Backup power</p><h2 class="mt-3 font-serif text-2xl font-semibold text-brand-navy">Power backup equipment</h2><p class="mt-4 text-sm leading-7 text-brand-muted">Explore inverters and batteries for home or business requirements. Compatibility, battery sizing and installation requirements must be verified for each project.</p><a href={withBase('/category/inverters/')} class="text-link mt-5">Browse inverters ↗</a></div>
      </article>
      <article class="overflow-hidden border border-brand-border bg-white">
        <div class="flex h-64 items-center justify-center bg-brand-pale p-8"><img src={responsiveImage('/assets/products/solar-panels/4707-ja_solar_605w_jam72d40_lb.webp',960).src} alt="Solar PV module" width="600" height="420" class="h-full w-full object-contain" loading="lazy" /></div>
        <div class="p-7 sm:p-9"><p class="section-eyebrow">02 / Solar energy</p><h2 class="mt-3 font-serif text-2xl font-semibold text-brand-navy">Solar equipment selection</h2><p class="mt-4 text-sm leading-7 text-brand-muted">Compare solar panels and related energy components for different applications. Ask us to confirm current models and configurations.</p><a href={withBase('/shop/solar/')} class="text-link mt-5">Browse solar equipment ↗</a></div>
      </article>
      <article class="overflow-hidden border border-brand-border bg-white">
        <div class="flex h-64 items-center justify-center bg-brand-pale p-8"><img src={responsiveImage('/assets/products/solar-water-pumps/4714-grundfos-sp-small.jpg',960).src} alt="Water pump equipment" width="600" height="420" class="h-full w-full object-contain" loading="lazy" /></div>
        <div class="p-7 sm:p-9"><p class="section-eyebrow">03 / Water</p><h2 class="mt-3 font-serif text-2xl font-semibold text-brand-navy">Solar water pumping products</h2><p class="mt-4 text-sm leading-7 text-brand-muted">Explore pump models and control equipment for agriculture and water access. Site-specific selection requires information about the pump application and conditions.</p><a href={withBase('/category/solar-water-pumps/')} class="text-link mt-5">Explore water pumps ↗</a></div>
      </article>
      <article class="overflow-hidden border border-brand-border bg-white">
        <div class="flex h-64 items-center justify-center bg-brand-pale p-8"><img src={responsiveImage('/assets/products/speakers/4980-01._JBL_EON715_3-4_Extreme_vert_medium.png',960).src} alt="Professional PA loudspeaker" width="600" height="420" class="h-full w-full object-contain" loading="lazy" /></div>
        <div class="p-7 sm:p-9"><p class="section-eyebrow">04 / Audio</p><h2 class="mt-3 font-serif text-2xl font-semibold text-brand-navy">Professional sound equipment</h2><p class="mt-4 text-sm leading-7 text-brand-muted">Browse speakers, microphones, mixers and amplifiers for event spaces, houses of worship, institutions and professional use.</p><a href={withBase('/shop/sound/')} class="text-link mt-5">Browse sound equipment ↗</a></div>
      </article>
    </section>

    <section class="border-t border-brand-border py-14 lg:py-20">
      <p class="section-eyebrow mb-4">Straightforward next steps</p><h2 class="section-heading max-w-3xl">From requirement to quotation.</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <div class="border-t-2 border-brand-blue pt-5"><p class="section-eyebrow">01 · Browse</p><h3 class="mt-3 text-xl font-semibold text-brand-navy">Choose an application</h3><p class="mt-3 text-sm leading-7 text-brand-muted">Select a product category or share the equipment you already have in mind.</p></div>
        <div class="border-t-2 border-brand-blue pt-5"><p class="section-eyebrow">02 · Enquire</p><h3 class="mt-3 text-xl font-semibold text-brand-navy">Describe your requirements</h3><p class="mt-3 text-sm leading-7 text-brand-muted">Provide intended use, location and important technical details so the team can respond accurately.</p></div>
        <div class="border-t-2 border-brand-blue pt-5"><p class="section-eyebrow">03 · Confirm</p><h3 class="mt-3 text-xl font-semibold text-brand-navy">Receive current information</h3><p class="mt-3 text-sm leading-7 text-brand-muted">Confirm product specifications, availability and quotation terms before proceeding.</p></div>
      </div>
    </section>
    <section class="mb-20 flex flex-col gap-6 bg-brand-navy px-7 py-10 text-white sm:px-12 lg:flex-row lg:items-center lg:justify-between lg:py-14">
      <div><p class="text-xs font-bold uppercase tracking-widest text-[#BED4FF]">Talk to Universal Electronics</p><h2 class="mt-3 font-serif text-3xl font-semibold">Need help choosing equipment?</h2><p class="mt-3 max-w-xl text-sm text-[#D5E4FF]">Tell us the product, model or application, and we will help you take the next step.</p></div>
      <a href={withBase('/contact/?interest=Solar%20equipment')} class="button-light shrink-0">Request a quotation ↗</a>
    </section>
  </div>
</Layout>
