---
import ContactIcon from '../components/ContactIcon.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { siteConfig } from '../data/siteConfig';
import { socialProfiles } from '../data/socialProfiles';
import { businessLocation } from '../data/businessLocation';
import { withBase } from '../lib/paths';
import { responsiveImage } from '../lib/responsiveImage';
const phone = siteConfig.phones[0];
const whatsapp = `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent('Hello Universal Electronics, I would like to make an enquiry.')}`;
const canonical = 'https://universalelectronicet.com/connect/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <meta name="theme-color" content="#012483" />
    <meta name="description" content="Connect with Universal Electronics in Addis Ababa. Solar and sound solutions, contact details, directions and social media." />
    <title>Mesfin | Universal Electronics</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={withBase('/assets/brand/4404-logo-uni.png')} />
    <meta property="og:title" content="Mesfin | Universal Electronics" />
    <meta property="og:description" content="Your Source for Solar and Sound Solutions. Call, message, save our contact or visit us in Addis Ababa." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://universalelectronicet.com/assets/people/mesfin-professional.webp" />
  </head>
  <body>
    <main class="card">
      <header class="intro">
        <div class="cover">
          <div class="brand"><img src={withBase('/assets/brand/ref-52939cff-cropped-logo-uni.png')} alt="Universal Electronics" width="150" height="58" /></div>
          <button id="share-card" class="share" aria-label="Share Mesfin’s contact page" type="button"><ContactIcon name="share" /></button>
        </div>
        <div class="profile">
          <img class="portrait" src={withBase('/assets/people/mesfin-professional.webp')} alt="Professional portrait of Mesfin" width="136" height="136" fetchpriority="high" />
          <p class="location">ADDIS ABABA, ETHIOPIA</p>
          <h1>Mesfin</h1>
          <p class="company">Universal Electronics</p>
          <p class="tagline">{siteConfig.tagline}</p>
        </div>
      </header>
      <div class="body">
        <a class="save" href={withBase('/universal-electronics.vcf')} download="Mesfin-Universal-Electronics.vcf"><ContactIcon name="download" /><span>Save contact</span><span class="save-plus" aria-hidden="true">+</span></a>
        <p class="hint">Connect with Mesfin at Universal Electronics.</p>
        <section aria-labelledby="contact-heading">
          <div class="section-head"><h2 id="contact-heading">Let’s connect</h2></div>
          <div class="quick-actions">
            <a class="quick" href={`tel:${phone.replace(/\s+/g, '')}`}><span class="icon"><ContactIcon name="phone" /></span><strong>Call us</strong><span>{phone}</span></a>
            <a class="quick whatsapp" href={whatsapp} target="_blank" rel="noopener noreferrer"><span class="icon"><ContactIcon name="message" /></span><strong>WhatsApp</strong><span>Start a conversation</span></a>
          </div>
          <a class="link-row" href={`mailto:${siteConfig.email}`}><span class="row-icon"><ContactIcon name="mail" /></span><span class="row-text"><strong>Email us</strong><span>{siteConfig.email}</span></span><ContactIcon name="arrow" /></a>
          <a class="link-row" href={businessLocation.googleMapsUrl} target="_blank" rel="noopener noreferrer"><span class="row-icon"><ContactIcon name="pin" /></span><span class="row-text"><strong>Visit our store</strong><span>{siteConfig.address} · {siteConfig.city}</span></span><ContactIcon name="arrow" /></a>
        </section>
        <section aria-labelledby="social-heading">
          <div class="section-head"><h2 id="social-heading">Find us online</h2></div>
          <div class="social-grid">
            {socialProfiles.map(profile => <a class="social" href={profile.url} target="_blank" rel="noopener noreferrer"><SocialIcon platform={profile.platform} /><span>{profile.label}</span><span class="external" aria-hidden="true">↗</span></a>)}
            <a class="social telegram" href={siteConfig.telegramUrl} target="_blank" rel="noopener noreferrer"><ContactIcon name="send" /><span>Telegram</span><span class="external" aria-hidden="true">↗</span></a>
          </div>
        </section>
        <section aria-labelledby="explore-heading">
          <div class="section-head"><h2 id="explore-heading">Explore Universal</h2></div>
          <div class="collections">
            <a href={withBase('/shop/solar/')}><div class="collection-photo"><img src={responsiveImage('/assets/projects/5315-480A8802-2-min-scaled.avif',480).src} alt="" width="220" height="140" loading="lazy" /></div><div class="collection-label"><span>Solar &amp; power</span><ContactIcon name="arrow" /></div></a>
            <a href={withBase('/shop/sound/')}><div class="collection-photo sound-photo"><img src={responsiveImage('/assets/products/speakers/4980-01._JBL_EON715_3-4_Extreme_vert_medium.png',480).src} alt="" width="220" height="140" loading="lazy" /></div><div class="collection-label"><span>Sound systems</span><ContactIcon name="arrow" /></div></a>
          </div>
          <a class="website" href={withBase('/')}><ContactIcon name="globe" /><span>Visit our website</span><ContactIcon name="arrow" /></a>
        </section>
        <p id="share-status" class="share-status" role="status" aria-live="polite"></p>
        <footer><span class="footer-mark" aria-hidden="true"></span><span>Universal Electronics<br /><span class="footer-city">Addis Ababa, Ethiopia</span></span></footer>
      </div>
    </main>
    <script>
      document.getElementById('share-card')?.addEventListener('click', async () => {
        const url = window.location.href;
        const status = document.getElementById('share-status');
        try {
          if (navigator.share) await navigator.share({ title: 'Mesfin | Universal Electronics', url });
          else { await navigator.clipboard.writeText(url); if (status) status.textContent = 'Contact page link copied.'; }
        } catch (error) {
          if (error instanceof Error && error.name === 'AbortError') return;
          if (status) status.textContent = `Share this link: ${url}`;
        }
      });
    </script>
  </body>
</html>
<style>
  :global(*){box-sizing:border-box} :global(body){margin:0;background:#eef2f7;color:#172842;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:14px;-webkit-font-smoothing:antialiased} :global(a){color:inherit;text-decoration:none} :global(button){font:inherit} :global(a:focus-visible),:global(button:focus-visible){outline:3px solid #005ee9;outline-offset:4px} .card{max-width:490px;margin:32px auto;background:#fff;border-radius:24px;overflow:hidden;box-shadow:0 18px 70px #132b4f12}.intro{text-align:center}.cover{height:139px;padding:20px 24px;display:flex;align-items:flex-start;justify-content:space-between;position:relative;isolation:isolate;overflow:hidden;background:linear-gradient(115deg,#00195e,#012483 65%,#154fb1)}.cover:after{content:"";position:absolute;z-index:-1;width:320px;height:320px;border:50px solid #ffffff06;border-radius:50%;right:-70px;top:-140px;box-shadow:0 0 0 35px #ffffff04}.brand{display:flex;align-items:center;justify-content:center;background:#fff;padding:8px 12px;border-radius:9px}.brand img{width:107px;height:auto;display:block}.share{display:grid;place-items:center;border:1px solid #ffffff40;background:#ffffff0b;color:#fff;border-radius:50%;width:42px;height:42px;cursor:pointer}.profile{position:relative;padding:0 24px}.portrait{position:relative;display:block;margin:-58px auto 0;border:6px solid #fff;border-radius:50%;width:136px;height:136px;object-fit:cover;box-shadow:0 3px 14px #0d285b0f}.location{font-size:9px;color:#76849a;letter-spacing:1.6px;margin:17px 0 8px;font-weight:650}h1{font-size:34px;letter-spacing:-1px;line-height:1.15;margin:0;color:#0c2146;font-weight:720}.company{margin:8px 0 0;color:#012483;font-size:15px;font-weight:650}.tagline{font-size:13px;line-height:1.6;color:#66748a;margin:9px 0 0}.body{padding:23px 26px 22px}.save{background:#005ee9;color:#fff;min-height:52px;border-radius:12px;display:flex;align-items:center;justify-content:center;gap:10px;font-weight:650;font-size:14px}.save-plus{display:none}.hint{text-align:center;font-size:11px;color:#7b879a;margin:10px 0 25px}.section-head{margin:25px 0 14px}h2{font-size:16px;letter-spacing:-.3px;margin:0;font-weight:650}.quick-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}.quick{padding:15px 13px;background:#f5f8fc;border:1px solid #eaf0f7;border-radius:13px;display:flex;flex-direction:column;gap:6px}.quick strong{font-size:14px}.icon{color:#005ee9;margin-bottom:4px}.quick>span:last-child{font-size:11px;color:#627088}.whatsapp{background:#f2faf5;border-color:#e2f0e7}.whatsapp .icon{color:#1b8550}.row-icon{color:#547099;flex-shrink:0;width:30px}.link-row{display:flex;align-items:center;gap:11px;border-bottom:1px solid #edf1f6;padding:18px 2px}.row-text{flex:1;display:flex;flex-direction:column;gap:5px;min-width:0}.row-text strong{font-weight:600;font-size:13px}.row-text>span{font-size:11px;line-height:1.5;color:#748197;overflow-wrap:anywhere}.link-row> :global(svg){width:17px;color:#8794a8;flex-shrink:0}.social-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.social{min-height:51px;display:flex;align-items:center;gap:11px;padding:0 13px;border:1px solid #e6ebf3;border-radius:11px;font-size:12px;font-weight:600}.social> :global(svg){width:18px;height:18px;color:#012483;flex-shrink:0}.external{margin-left:auto;color:#8b96aa}.telegram{grid-column:1/-1}.collections{display:grid;grid-template-columns:1fr 1fr;gap:11px}.collections>a{border:1px solid #e6ecf5;border-radius:13px;overflow:hidden;background:#f8faff}.collection-photo{height:115px;background:#f1f5fa;overflow:hidden}.collection-photo img{width:100%;height:100%;object-fit:cover;display:block}.sound-photo img{object-fit:contain;padding:8px}.collection-label{display:flex;align-items:center;justify-content:space-between;gap:5px;padding:13px 11px;font-size:12px;font-weight:650;background:#fff}.collection-label :global(svg){width:16px;flex-shrink:0}.website{display:flex;align-items:center;justify-content:center;gap:11px;border:1px solid #dce4f1;border-radius:12px;padding:16px;margin-top:12px;font-size:13px;font-weight:600;color:#012483}.website :global(svg){width:18px}.website> :global(svg):last-child{margin-left:auto}.website> :global(svg):first-child{margin-right:auto}footer{margin-top:27px;padding-top:18px;border-top:1px solid #edf1f6;display:flex;justify-content:center;align-items:center;gap:9px;font-size:10px;color:#53617a;line-height:1.7}.footer-mark{width:5px;height:23px;background:#005ee9;border-radius:4px}.footer-city{font-size:9px;color:#8792a5}.share-status{font-size:11px;overflow-wrap:anywhere;color:#53617a}.share-status:empty{display:none}@media(hover:hover){a,button{transition:background .18s ease,box-shadow .18s ease}.save:hover{background:#004ec2}.social:hover,.quick:hover,.collections>a:hover{box-shadow:0 4px 14px #0c285b0b}.share:hover{background:#ffffff20}}@media(max-width:520px){.card{margin:0 auto;border-radius:0;min-height:100svh;box-shadow:none}.body{padding:22px 22px max(22px,env(safe-area-inset-bottom))}.cover{height:132px;padding:18px 21px}.profile{padding:0 20px}.portrait{width:126px;height:126px;margin-top:-53px}.location{margin-top:15px}.tagline{font-size:12px}}@media(max-width:350px){.body{padding-left:16px;padding-right:16px}.quick>span:last-child{font-size:10px}.company{font-size:14px}.collection-label{font-size:11px;padding:12px 9px}}@media(prefers-reduced-motion:reduce){:global(*){transition:none!important}}
</style>
