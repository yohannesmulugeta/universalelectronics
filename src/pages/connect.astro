---
import ContactIcon from '../components/ContactIcon.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { siteConfig } from '../data/siteConfig';
import { socialProfiles } from '../data/socialProfiles';
import { businessLocation } from '../data/businessLocation';
import { withBase } from '../lib/paths';
const phone = siteConfig.phones[0];
const whatsapp = `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent('Hello Universal Electronics, I would like to make an enquiry.')}`;
const canonical = 'https://universalelectronicet.com/connect/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <meta name="theme-color" content="#012483" />
    <meta name="description" content="Connect with Universal Electronics in Addis Ababa. Solar and sound solutions, contact details, directions and social media." />
    <title>Connect | Universal Electronics</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={withBase('/assets/brand/4404-logo-uni.png')} />
    <meta property="og:title" content="Universal Electronics | Let's connect" />
    <meta property="og:description" content="Your Source for Solar and Sound Solutions. Call, message, save our contact or visit us in Addis Ababa." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://universalelectronicet.com/assets/brand/4404-logo-uni.png" />
  </head>
  <body>
    <main class="card">
      <header class="intro">
        <div class="intro-top"><span class="eyebrow">POWER. SOUND. CONNECTION.</span><button id="share-card" class="share" aria-label="Share this contact page" type="button"><ContactIcon name="share" /></button></div>
        <div class="brand"><img src={withBase('/assets/brand/ref-52939cff-cropped-logo-uni.png')} alt="Universal Electronics logo" width="180" height="70" /></div>
        <p class="location">ADDIS ABABA, ETHIOPIA</p>
        <h1>Universal<br />Electronics<span>.</span></h1>
        <p class="tagline">{siteConfig.tagline}</p>
        <div class="tags"><span>Solar &amp; power</span><span>Professional audio</span></div>
      </header>
      <div class="body">
        <a class="save" href={withBase('/universal-electronics.vcf')} download="Universal-Electronics.vcf"><ContactIcon name="download" /><span>Save our contact</span><span class="save-plus" aria-hidden="true">+</span></a>
        <p class="hint">Keep Universal Electronics a tap away.</p>
        <section aria-labelledby="contact-heading">
          <div class="section-head"><h2 id="contact-heading">Let’s connect</h2><span>01 / CONTACT</span></div>
          <div class="quick-actions">
            <a class="quick" href={`tel:${phone.replace(/\s+/g, '')}`}><span class="icon"><ContactIcon name="phone" /></span><strong>Call us</strong><span>{phone}</span></a>
            <a class="quick whatsapp" href={whatsapp} target="_blank" rel="noopener noreferrer"><span class="icon"><ContactIcon name="message" /></span><strong>WhatsApp</strong><span>Start a conversation</span></a>
          </div>
          <a class="link-row" href={`mailto:${siteConfig.email}`}><span class="row-icon"><ContactIcon name="mail" /></span><span class="row-text"><strong>Email us</strong><span>{siteConfig.email}</span></span><ContactIcon name="arrow" /></a>
          <a class="link-row" href={businessLocation.googleMapsUrl} target="_blank" rel="noopener noreferrer"><span class="row-icon"><ContactIcon name="pin" /></span><span class="row-text"><strong>Visit our store</strong><span>{siteConfig.address} · {siteConfig.city}</span></span><ContactIcon name="arrow" /></a>
        </section>
        <section aria-labelledby="social-heading">
          <div class="section-head"><h2 id="social-heading">Follow along</h2><span>02 / SOCIAL</span></div>
          <div class="social-grid">
            {socialProfiles.map(profile => <a class="social" href={profile.url} target="_blank" rel="noopener noreferrer"><SocialIcon platform={profile.platform} /><span>{profile.label}</span><span class="external" aria-hidden="true">↗</span></a>)}
            <a class="social telegram" href={siteConfig.telegramUrl} target="_blank" rel="noopener noreferrer"><ContactIcon name="send" /><span>Telegram</span><span class="external" aria-hidden="true">↗</span></a>
          </div>
        </section>
        <section aria-labelledby="explore-heading">
          <div class="section-head"><h2 id="explore-heading">Explore Universal</h2><span>03 / DISCOVER</span></div>
          <div class="collections"><a href={withBase('/shop/solar/')}><span class="collection-num">01</span><span>Solar &amp; power</span><ContactIcon name="arrow" /></a><a href={withBase('/shop/sound/')}><span class="collection-num">02</span><span>Sound systems</span><ContactIcon name="arrow" /></a></div>
          <a class="website" href={withBase('/')}><ContactIcon name="globe" /><span>Visit our website</span><ContactIcon name="arrow" /></a>
        </section>
        <p id="share-status" class="share-status" role="status" aria-live="polite"></p>
        <footer><span class="footer-mark" aria-hidden="true"></span><span>Universal Electronics<br /><span class="footer-city">Addis Ababa, Ethiopia</span></span></footer>
      </div>
    </main>
    <script>
      document.getElementById('share-card')?.addEventListener('click', async () => {
        const url = window.location.href;
        const status = document.getElementById('share-status');
        try {
          if (navigator.share) await navigator.share({ title: 'Universal Electronics', url });
          else { await navigator.clipboard.writeText(url); if (status) status.textContent = 'Contact page link copied.'; }
        } catch (error) {
          if (error instanceof Error && error.name === 'AbortError') return;
          if (status) status.textContent = `Share this link: ${url}`;
        }
      });
    </script>
  </body>
</html>
<style>
  :global(*){box-sizing:border-box} :global(body){margin:0;background:#edf1f7;color:#13244a;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:14px;-webkit-font-smoothing:antialiased} :global(a){color:inherit;text-decoration:none} :global(button){font:inherit} :global(a:focus-visible),:global(button:focus-visible){outline:3px solid #f4bb49;outline-offset:4px} .card{max-width:500px;margin:36px auto;background:#fff;border-radius:26px;overflow:hidden;box-shadow:0 15px 70px #0c255415}.intro{position:relative;isolation:isolate;overflow:hidden;padding:24px 30px 34px;background:#012483;color:white}.intro:before,.intro:after{content:"";position:absolute;z-index:-1;border:1px solid #ffffff14;border-radius:50%;width:350px;height:350px;right:-190px;bottom:-130px}.intro:after{width:470px;height:470px;right:-250px;bottom:-190px}.intro-top{display:flex;justify-content:space-between;align-items:center;gap:12px}.eyebrow{font-size:9px;letter-spacing:2px;font-weight:700;color:#c2d4ff}.share{display:grid;place-items:center;border:1px solid #ffffff40;background:#ffffff0b;color:white;border-radius:50%;width:40px;height:40px;cursor:pointer}.brand{display:inline-flex;align-items:center;justify-content:center;background:#fff;padding:10px 16px;border-radius:12px;margin-top:20px}.brand img{width:148px;height:auto;display:block}.location{margin:28px 0 12px;font-size:10px;letter-spacing:2px;color:#c2d4ff}h1{font-size:42px;line-height:1.08;letter-spacing:-1.6px;margin:0;font-weight:750}h1 span{color:#f4bb49}.tagline{font-size:14px;line-height:1.6;max-width:280px;color:#d4dfff;margin:16px 0 22px}.tags{display:flex;gap:8px;flex-wrap:wrap}.tags span{padding:7px 11px;border:1px solid #ffffff40;border-radius:30px;font-size:10px}.body{padding:25px 26px 20px}.save{background:#005ee9;color:white;min-height:54px;border-radius:12px;display:flex;align-items:center;justify-content:center;gap:12px;font-size:14px;font-weight:650}.save-plus{margin-left:auto;font-size:23px;font-weight:400}.save svg{margin-right:auto}.save{padding:0 18px}.hint{text-align:center;color:#67758b;font-size:11px;margin:11px 0 30px}.section-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:28px 0 16px}h2{margin:0;font-size:18px;letter-spacing:-.5px}.section-head>span{font-size:8px;letter-spacing:1.3px;color:#78859b;font-weight:650}.quick-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}.quick{background:#f3f6fb;border:1px solid #e9eef6;border-radius:14px;padding:16px 12px;display:flex;flex-direction:column;gap:7px}.icon{display:grid;place-items:center;width:34px;height:34px;background:white;border-radius:10px;color:#005ee9;margin-bottom:4px}.quick strong{font-size:14px}.quick>span:last-child{font-size:10px;color:#56647c}.whatsapp{background:#f0f8f3;border-color:#e2eee6}.whatsapp .icon{color:#177e43}.link-row{display:flex;align-items:center;gap:13px;padding:18px 0;border-bottom:1px solid #edf0f5}.row-icon{display:grid;place-items:center;width:36px;height:36px;flex-shrink:0;border-radius:10px;background:#f3f6fb;color:#005ee9}.row-text{flex:1;min-width:0;display:flex;flex-direction:column;gap:5px}.row-text strong{font-size:13px}.row-text>span{font-size:11px;color:#67758b;line-height:1.5;overflow-wrap:anywhere}.link-row>svg{width:16px;color:#8b96aa;flex-shrink:0}.social-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.social{min-height:51px;display:flex;align-items:center;gap:11px;padding:0 13px;border:1px solid #e6ebf3;border-radius:11px;font-size:12px;font-weight:600}.social>svg{width:17px;height:17px;color:#012483;flex-shrink:0}.external{margin-left:auto;color:#8b96aa}.telegram{grid-column:1/-1}.collections{background:#f3f6fb;border-radius:12px;padding:0 14px}.collections>a{display:flex;align-items:center;gap:14px;min-height:56px;font-size:13px;font-weight:600}.collections>a+a{border-top:1px solid #e0e6f0}.collection-num{font-size:9px;color:#7b89a0;letter-spacing:1px}.collections svg{margin-left:auto;width:17px}.website{display:flex;align-items:center;justify-content:center;gap:10px;border:1px solid #ced9ee;border-radius:12px;padding:16px;margin-top:12px;font-size:12px;font-weight:600;color:#012483}.website>svg{width:17px}.website>svg:last-child{margin-left:auto}.website>svg:first-child{margin-right:auto}footer{margin-top:28px;padding-top:18px;border-top:1px solid #edf0f5;display:flex;align-items:center;justify-content:center;gap:10px;font-size:10px;line-height:1.8;color:#53617a}.footer-mark{width:6px;height:24px;border-radius:3px;background:#005ee9}.footer-city{font-size:9px;color:#8792a5}.share-status{font-size:11px;overflow-wrap:anywhere;color:#53617a}.share-status:empty{display:none}@media(hover:hover){a,button{transition:background .18s ease,transform .18s ease}.save:hover{background:#004ec2}.social:hover,.link-row:hover{background:#f5f8fd}.share:hover{background:#ffffff25}}@media(max-width:540px){.card{margin:0 auto;border-radius:0;box-shadow:none;min-height:100svh}.intro{padding:20px 25px 30px}.body{padding:24px 22px;padding-bottom:max(24px,env(safe-area-inset-bottom))}}@media(max-width:350px){.intro{padding:18px 20px 28px}.body{padding:22px 16px}h1{font-size:38px}.section-head>span{font-size:7px}.quick>span:last-child{font-size:9px}}@media(prefers-reduced-motion:reduce){:global(*){transition:none!important}}
</style>
