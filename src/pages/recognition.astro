---
import { withBase } from '../lib/paths';
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { recognitionDocs } from '../data/recognition';
---

<Layout title="Recognition Archive | Universal Electronics"
  description="View recognition documents and letters preserved from the previous Universal Electronics website.">
  <div class="max-w-site mx-auto px-4 sm:px-6 py-6 sm:py-8">
    <Breadcrumb items={[{ label: 'Recognition' }]} />
    <section class="max-w-3xl py-10 lg:py-16" data-reveal>
      <p class="section-eyebrow mb-5">Our archive</p>
      <h1 class="font-serif text-4xl sm:text-5xl text-brand-navy leading-tight">Recognition & documents</h1>
      <p class="mt-6 text-lg leading-relaxed text-slate-600">
        A collection of letters and certificates preserved from our previous website. Open an image to read the original document.
      </p>
    </section>
    <section class="grid md:grid-cols-2 gap-6 mb-20" aria-label="Recognition documents">
      {recognitionDocs.map((doc) => (
        <a href={withBase(doc.image)} target="_blank" rel="noopener noreferrer"
          class="group block bg-white border border-brand-border hover:border-brand-blue transition-colors">
          <div class="aspect-[4/3] overflow-hidden bg-brand-offwhite p-5">
            <img src={withBase(doc.image)} alt={doc.title} class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-[1.02]"
              loading="lazy" width="800" height="600" />
          </div>
          <div class="p-5 flex items-center justify-between gap-4">
            <h2 class="font-serif text-lg text-brand-navy">{doc.title}</h2>
            <span class="text-brand-blue shrink-0" aria-hidden="true">↗</span>
          </div>
        </a>
      ))}
    </section>
  </div>
</Layout>
