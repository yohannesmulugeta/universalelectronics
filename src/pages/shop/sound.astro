---
import { withBase } from '../../lib/paths';
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products } from '../../data/products';
import { categories } from '../../data/taxonomy';

const soundCategories = categories.filter((c) => c.section === 'sound');
const soundProducts = products.filter((p) => p.section === 'sound');
---

<Layout
  title="Professional Sound Systems | Universal Electronics"
  description="Discover 20 professional sound products: PA speakers, amplifiers, microphones, keyboards, and audio mixers in Addis Ababa, Ethiopia."
>
  <div class="max-w-site mx-auto px-5 sm:px-8 py-6 sm:py-8">
    <Breadcrumb
      items={[
        { label: 'Product Catalog', href: '/shop/' },
        { label: 'Sound Equipment' },
      ]}
    />

    <!-- Header Section -->
    <div class="mb-16 pt-10 sm:pt-16">
      <div class="section-eyebrow mb-5">
        <span>Sound equipment · {soundProducts.length} products</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-semibold text-brand-navy mb-5">
        Professional Sound Systems
      </h1>
      <p class="text-base text-brand-muted max-w-2xl leading-8">
        Explore speakers, amplifiers, microphones, mixers and instruments. Open a product to see catalog details and ask us about availability.
      </p>

      <!-- Category Navigation Tiles -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mt-12">
        {
          soundCategories.map((cat) => (
            <a
              href={withBase(`/category/${cat.slug}/`)}
              class="group flex flex-col p-5 border-t border-brand-navy bg-brand-offwhite hover:bg-white transition-colors"
            >
              <span class="font-semibold text-brand-navy group-hover:text-brand-blue text-sm">
                {cat.name}
              </span>
              <span class="text-xs text-brand-muted mt-1">
                {cat.count} {cat.count === 1 ? 'model' : 'models'}
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <!-- Grouped Sections for Each Sound Category -->
    <div class="space-y-14">
      {
        soundCategories.map((cat) => {
          const items = soundProducts.filter((p) => p.categorySlug === cat.slug);
          return (
            <section id={cat.slug} class="scroll-mt-24 pt-4 border-t border-slate-200">
              <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-6">
                <div>
                  <h2 class="font-serif text-xl sm:text-2xl font-bold text-brand-navy">
                    {cat.name}
                  </h2>
                  <p class="text-xs sm:text-sm text-slate-500 max-w-2xl mt-1">
                    {cat.description}
                  </p>
                </div>
                <a
                  href={withBase(`/category/${cat.slug}/`)}
                  class="text-xs font-semibold text-brand-blue hover:text-brand-blueHover shrink-0"
                >
                  View {cat.name} category page ({items.length}) →
                </a>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-12">
                {items.map((product) => (
                  <ProductCard product={product} />
                ))}
              </div>
            </section>
          );
        })
      }
    </div>
  </div>
</Layout>
