---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CatalogFilter from '../../components/CatalogFilter';
import { products } from '../../data/products';
import { categories } from '../../data/taxonomy';
// Send only catalog-filter fields to the browser instead of full specification tables and archive metadata.
const catalogProducts = products.map(({ id, title, slug, primaryBrand, categoryName, categorySlug, section, descriptionText, media }) => ({ id, title, slug, primaryBrand, categoryName, categorySlug, section, descriptionText: descriptionText.slice(0, 350), media: media.slice(0, 1) }));
---

<Layout
  title="Product Catalog | Universal Electronics"
  description="Browse all 59 published solar energy and professional sound products from Universal Electronics in Addis Ababa. Filter by category and brand."
>
  <div class="max-w-site mx-auto px-4 sm:px-6 py-6 sm:py-8">
    <Breadcrumb items={[{ label: 'Product Catalog' }]} />

    <div class="mb-7 grid gap-5 pt-8 pb-2 sm:mb-9 sm:pt-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(300px,.8fr)] lg:items-end lg:gap-12">
      <div>
        <p class="section-eyebrow mb-4">Universal Electronics / Catalog</p>
        <h1 class="max-w-3xl font-serif text-4xl font-semibold leading-tight text-brand-navy sm:text-5xl lg:text-6xl">Find the equipment you need.</h1>
      </div>
      <p class="max-w-xl text-base leading-7 text-brand-muted lg:pb-1">Search the complete catalog, compare equipment by category or manufacturer brand, and request current model details and availability.</p>
    </div>

    <div class="mb-8 flex flex-wrap gap-4 border-y border-brand-border bg-brand-offwhite px-5 py-5 text-sm text-brand-muted sm:items-center sm:justify-between"><p>Looking for a particular system or model? Tell us what you need.</p><a href="/contact/" class="text-link">Ask about equipment ↗</a></div>

    <!-- Interactive React Island for Catalog Filtering and Search -->
    <CatalogFilter
      client:load
      products={catalogProducts}
      categories={categories}
    />
  </div>
</Layout>
