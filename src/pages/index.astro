---
import { withBase } from '../lib/paths';
import { responsiveImage } from '../lib/responsiveImage';
import Layout from '../layouts/Layout.astro';
import CinematicHero from '../components/CinematicHero.astro';
import FeaturedCarousel from '../components/FeaturedCarousel.astro';
import BrandMarquee from '../components/BrandMarquee.astro';
import SolutionsAccordion from '../components/SolutionsAccordion.astro';
import CategoryShortcuts from '../components/CategoryShortcuts.astro';
import { products } from '../data/products';
import { recognitionDocs } from '../data/recognition';
import type { Product } from '../types';

const featuredSlugs = [
  'must-pv2900-hp-solar-inverter-1-6kw-off-grid-pure-sine-wave-inverter',
  'jbl-eon715',
  'ja-solar-605w-n-type-bifacial-panel',
  'ssa-250dp',
  'sun-king-home-120',
  'jbl-srx725-prx725-dual-15″-two-way-pa-speaker',
  'grundfos-sqf-5-70-n-solar-borehole-pump-built-in-mppt-ac-dc-hybrid-power',
  'yamaha-v10sg-natural-acoustic-violin',
];
const featuredProducts = featuredSlugs.map((slug) => products.find((product) => product.slug === slug)).filter((product): product is Product => Boolean(product));
---

<Layout title="Universal Electronics | Solar and Sound Equipment in Ethiopia"
  description="Discover solar power, backup batteries, water pumps and professional sound equipment in Addis Ababa. Explore the catalog and request a quotation.">
  <CinematicHero />

  <BrandMarquee />

  <SolutionsAccordion />

  <CategoryShortcuts />

  <FeaturedCarousel items={featuredProducts} />

  <section class="max-w-site mx-auto px-5 py-20 sm:px-8 lg:py-28" aria-labelledby="projects-heading">
    <div class="mb-9 flex flex-col justify-between gap-5 md:flex-row md:items-end">
      <div><p class="section-eyebrow mb-4">Beyond the catalog</p>
        <h2 id="projects-heading" class="section-heading max-w-3xl">See the equipment in context.</h2></div>
      <a href={withBase('/projects/')} class="text-link">Explore the project archive ↗</a>
    </div>
    <div class="ue-project-feature grid min-w-0 overflow-hidden bg-brand-navy lg:grid-cols-[.95fr_1.05fr]">
      <div class="flex min-w-0 flex-col justify-center px-7 py-12 text-white sm:px-12 sm:py-16 lg:px-14 lg:py-20">
        <p class="text-xs font-bold uppercase tracking-[.18em] text-[#BED4FF]">Project archive</p>
        <h3 class="mt-6 max-w-xl font-serif text-3xl font-semibold leading-tight text-white sm:text-4xl">Real requirements deserve careful planning.</h3>
        <p class="mt-6 max-w-lg text-sm leading-7 text-[#D5E4FF]">See archived solar and water-supply project examples. Illustrative recreations are clearly identified; specific project claims await business confirmation.</p>
        <div class="mt-8 flex flex-wrap gap-4"><a href={withBase('/projects/')} class="button-light">View project archive ↗</a><a href={withBase('/services/')} class="button-outline-light">Explore solutions ↗</a></div>
      </div>
      <div class="relative min-h-[320px] min-w-0 lg:min-h-[510px]">
        <img src={responsiveImage('/assets/projects/recreated-array-assembly.webp',1500).src} srcset={responsiveImage('/assets/projects/recreated-array-assembly.webp',1500).srcSet} sizes="(max-width:1024px) 100vw, 50vw" alt="Illustrative reconstruction of an archived solar-array assembly" width="1586" height="992" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
        <span class="absolute bottom-4 right-4 bg-white px-3 py-2 text-xs text-brand-navy">Illustrative project visual</span>
      </div>
    </div>
  </section>

  <section class="border-y border-brand-border bg-brand-offwhite py-20 lg:py-28" aria-labelledby="recognition-heading">
    <div class="max-w-site mx-auto px-5 sm:px-8">
      <div class="mb-10 flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
        <div><p class="section-eyebrow mb-4">Our documents</p><h2 id="recognition-heading" class="section-heading">Recognition & certificates</h2>
          <p class="mt-4 max-w-2xl leading-7 text-brand-muted">Explore original letters and certificate scans from the Universal Electronics archive. View the documents for their exact wording and dates.</p></div>
        <a href={withBase('/recognition/')} class="text-link shrink-0">View all five documents ↗</a>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        {recognitionDocs.slice(0, 3).map((doc) => (
          <a href={withBase(doc.image)} target="_blank" rel="noopener noreferrer" class="group flex min-w-0 flex-col overflow-hidden border border-brand-border bg-white transition-shadow hover:shadow-lg">
            <div class="flex aspect-[4/3] items-center justify-center overflow-hidden bg-white p-5">
              <img src={responsiveImage(doc.image, 480).src} srcset={responsiveImage(doc.image,480).srcSet} sizes="(max-width:640px) 92vw, 30vw" alt={doc.title} width="540" height="405" loading="lazy" decoding="async" class="h-full w-full object-contain transition-transform duration-300 group-hover:scale-[1.025]" />
            </div>
            <div class="flex flex-1 items-center justify-between gap-2 border-t border-brand-border p-5">
              <h3 class="text-sm font-semibold text-brand-navy">{doc.title}</h3><span aria-hidden="true" class="text-brand-blue">↗</span>
            </div>
          </a>
        ))}
      </div>
      <p class="mt-5 text-xs leading-6 text-brand-muted">Archived records; no claim of current certification, manufacturer authorization or endorsement is implied.</p>
    </div>
  </section>

  <section class="max-w-site mx-auto px-5 py-20 sm:px-8 lg:py-24" aria-labelledby="faq-heading">
    <div class="grid gap-10 lg:grid-cols-[.7fr_1fr] lg:gap-20">
      <div><p class="section-eyebrow mb-4">Before you enquire</p><h2 id="faq-heading" class="section-heading">A few useful answers.</h2><p class="mt-5 max-w-md text-sm leading-7 text-brand-muted">Practical information about browsing and enquiring through Universal Electronics.</p></div>
      <div class="divide-y divide-brand-border border-y border-brand-border">
        <details class="ue-faq-item group py-5"><summary>Can I buy directly from this website?</summary><p>Our website is currently a catalog and enquiry platform, not an online checkout. Contact our team to confirm the available model and purchasing arrangements.</p></details>
        <details class="ue-faq-item group py-5"><summary>Are the prices and stock shown online?</summary><p>Prices and availability are not published as live inventory. Request a quotation for current information before making a decision.</p></details>
        <details class="ue-faq-item group py-5"><summary>Can you help identify suitable solar or sound equipment?</summary><p>You can describe your application, location and equipment requirements through the enquiry channels. Exact specifications and compatibility must be confirmed for the intended use.</p></details>
        <details class="ue-faq-item group py-5"><summary>Where can I find Universal Electronics?</summary><p>Tefera Business Center | Habte Giyorgis<br /><span lang="am">ተፈራ የገበያ ማዕከል | ሀብተ ጊዮርጊስ</span><br />Addis Ababa, Ethiopia. Contact our team for visit details.</p></details>
      </div>
    </div>
  </section>

  <section class="bg-brand-pale py-20 lg:py-28" aria-labelledby="contact-heading">
    <div class="max-w-site mx-auto grid items-center gap-8 px-5 sm:px-8 lg:grid-cols-[1fr_auto]">
      <div><p class="section-eyebrow mb-5">Your next step</p>
        <h2 id="contact-heading" class="section-heading max-w-3xl">Ready to power your project?</h2>
        <p class="mt-5 max-w-2xl leading-8 text-brand-muted">Tell us which solar or professional sound equipment you need. Request a quotation and confirm specifications, availability and the exact model with our team.</p>
      </div>
      <a href={withBase('/contact/')} class="button-primary">Request a quotation ↗</a>
    </div>
  </section>
</Layout>
