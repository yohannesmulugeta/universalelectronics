---
import { withBase } from '../lib/paths';
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
import { siteConfig } from '../data/siteConfig';

const featuredProducts = products.filter((p) => [
  'must-pv2900-hp-solar-inverter-1-6kw-off-grid-pure-sine-wave-inverter',
  'lfeli-48200t48v-200ah',
  'ja-solar-605w-n-type-bifacial-panel',
  'grundfos-sqf-5-70-n-solar-borehole-pump-built-in-mppt-ac-dc-hybrid-power',
  'sun-king-home-120',
  'jbl-srx725-prx725-dual-15″-two-way-pa-speaker',
  'ssa-250dp',
  'yamaha-v10sg-natural-acoustic-violin',
].includes(p.slug)).slice(0, 8);
const solarCount = products.filter((p) => p.section === 'solar').length;
const soundCount = products.filter((p) => p.section === 'sound').length;
---

<Layout title="Universal Electronics | Solar and Sound Equipment in Ethiopia"
  description="Explore solar and sound equipment from Universal Electronics in Addis Ababa. Browse products and contact us directly for enquiries.">
  <section class="home-hero overflow-hidden">
    <div class="max-w-site mx-auto px-4 sm:px-6 grid lg:grid-cols-[1.04fr_.96fr] min-h-[570px]">
      <div class="flex flex-col justify-center py-20 lg:py-24 relative z-10" data-reveal>
        <p class="section-eyebrow mb-6">Universal Electronics · Addis Ababa</p>
        <h1 class="font-serif text-[clamp(2.8rem,5.5vw,5.5rem)] leading-[1.04] tracking-tight text-brand-navy max-w-[700px]">
          Power for every day.<br /><span class="text-brand-blue">Sound for every space.</span>
        </h1>
        <p class="mt-7 text-lg text-slate-600 leading-relaxed max-w-xl">
          Find solar equipment and professional sound systems in one place. Browse the catalog, then speak with us about the right product for your needs.
        </p>
        <div class="flex flex-wrap gap-3 mt-9">
          <a href={withBase('/shop/')} class="button-primary">Explore products <span aria-hidden="true">↗</span></a>
          <a href={withBase('/contact/')} class="button-secondary">Contact us</a>
        </div>
        <div class="flex gap-7 mt-14 pt-5 border-t border-slate-200 text-sm text-brand-navy">
          <a href={withBase('/shop/solar/')} class="text-link">Solar equipment <span aria-hidden="true">↗</span></a>
          <a href={withBase('/shop/sound/')} class="text-link">Sound equipment <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="relative flex items-center justify-center pb-12 lg:pb-0" data-reveal>
        <div class="hero-image-field absolute inset-0 lg:-right-[100vw]"></div>
        <img src={withBase('/assets/projects/4395-hero2-e1759613225895.png')}
          alt="Solar products from the Universal Electronics catalog"
          class="relative w-full max-w-[630px] max-h-[520px] object-contain drop-shadow-xl"
          width="630" height="520" loading="eager" />
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28" aria-labelledby="explore-heading">
    <div class="max-w-site mx-auto px-4 sm:px-6">
      <div class="max-w-2xl mb-12" data-reveal>
        <p class="section-eyebrow mb-4">Explore the catalog</p>
        <h2 id="explore-heading" class="section-heading">Two specialties. One place to start.</h2>
        <p class="mt-4 text-slate-600 leading-relaxed">Choose a category to see the products listed in our catalog.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-5">
        <a href={withBase('/shop/solar/')} class="category-feature group bg-[#eef4fa]" data-reveal>
          <span class="section-eyebrow">01 / Solar</span>
          <div><h3 class="font-serif text-3xl sm:text-4xl text-brand-navy">Solar energy</h3>
            <p class="text-slate-600 mt-3 max-w-md">Panels, inverters, batteries, pumps and portable lighting.</p></div>
          <span class="category-feature-bottom"><span>{solarCount} products</span><span aria-hidden="true" class="category-arrow">↗</span></span>
        </a>
        <a href={withBase('/shop/sound/')} class="category-feature group bg-[#eef0f7]" data-reveal>
          <span class="section-eyebrow">02 / Sound</span>
          <div><h3 class="font-serif text-3xl sm:text-4xl text-brand-navy">Professional sound</h3>
            <p class="text-slate-600 mt-3 max-w-md">Speakers, amplifiers, microphones, mixers and instruments.</p></div>
          <span class="category-feature-bottom"><span>{soundCount} products</span><span aria-hidden="true" class="category-arrow">↗</span></span>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-brand-offwhite py-20 lg:py-24" aria-labelledby="featured-heading">
    <div class="max-w-site mx-auto px-4 sm:px-6">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-10" data-reveal>
        <div><p class="section-eyebrow mb-4">From the catalog</p><h2 id="featured-heading" class="section-heading">Explore the range</h2></div>
        <a href={withBase('/shop/')} class="text-link shrink-0">View all products <span aria-hidden="true">↗</span></a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {featuredProducts.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>

  <section class="max-w-site mx-auto px-4 sm:px-6 py-20 lg:py-28 grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
    <div data-reveal>
      <p class="section-eyebrow mb-4">Beyond the catalog</p>
      <h2 class="section-heading">See the work behind the products.</h2>
      <p class="text-slate-600 leading-relaxed mt-5 max-w-xl">Browse the project and recognition records preserved from our previous website.</p>
      <div class="flex gap-6 mt-8">
        <a href={withBase('/projects/')} class="text-link">Projects <span aria-hidden="true">↗</span></a>
        <a href={withBase('/recognition/')} class="text-link">Recognition <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="overflow-hidden bg-[#eef4fa] aspect-[4/3]" data-reveal>
      <img src={withBase('/assets/projects/4650-project-2-1.png')} alt="Solar array photograph from the Universal Electronics archive"
        class="w-full h-full object-cover image-zoom" width="800" height="600" loading="lazy" />
    </div>
  </section>

  <section class="bg-brand-navy text-white py-16 lg:py-20">
    <div class="max-w-site mx-auto px-4 sm:px-6 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8" data-reveal>
      <div><p class="text-sky-300 text-xs uppercase tracking-[.18em] font-semibold mb-4">Have a product in mind?</p>
        <h2 class="font-serif text-3xl sm:text-4xl text-white">Let's talk about what you need.</h2>
        <p class="text-slate-300 mt-4">Send us the product name or tell us about your project.</p></div>
      <div class="flex flex-wrap gap-3">
        <a href={`https://wa.me/${siteConfig.whatsappNumber}`} target="_blank" rel="noopener noreferrer" class="button-light">WhatsApp <span aria-hidden="true">↗</span></a>
        <a href={siteConfig.telegramUrl} target="_blank" rel="noopener noreferrer" class="button-outline-light">Telegram <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</Layout>
