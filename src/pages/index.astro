---
import { withBase } from '../lib/paths';
import Layout from '../layouts/Layout.astro';
import { products } from '../data/products';
import { projects } from '../data/projects';
import { siteConfig } from '../data/siteConfig';

const featuredSlugs = [
  'must-pv2900-hp-solar-inverter-1-6kw-off-grid-pure-sine-wave-inverter',
  'lfeli-48200t48v-200ah',
  'ja-solar-605w-n-type-bifacial-panel',
  'jbl-srx725-prx725-dual-15″-two-way-pa-speaker',
  'ssa-250dp',
];

const featuredProducts = featuredSlugs
  .map((slug) => products.find((product) => product.slug === slug))
  .filter((product): product is (typeof products)[number] => Boolean(product));

const solarCount = products.filter((product) => product.section === 'solar').length;
const soundCount = products.filter((product) => product.section === 'sound').length;

const solutionGroups = [
  {
    number: '01',
    label: 'Backup power',
    description: 'Explore inverter options for dependable solar power systems.',
    href: '/category/inverters/',
  },
  {
    number: '02',
    label: 'Energy storage',
    description: 'Browse battery options for solar and backup applications.',
    href: '/category/solar-batteries/',
  },
  {
    number: '03',
    label: 'Solar water pumping',
    description: 'Find solar pump equipment for water-moving applications.',
    href: '/category/solar-water-pumps/',
  },
  {
    number: '04',
    label: 'PA & venue sound',
    description: 'Explore speakers for events, venues and installed sound.',
    href: '/category/speakers/',
  },
  {
    number: '05',
    label: 'Voice & conference',
    description: 'Browse microphones for speech, meetings and live use.',
    href: '/category/microphones/',
  },
  {
    number: '06',
    label: 'Mixing & amplification',
    description: 'Build out the signal chain with mixers and amplifiers.',
    href: '/shop/sound/',
  },
];
---

<Layout
  title="Universal Electronics | Solar & Professional Sound in Ethiopia"
  description="Explore solar equipment and professional sound systems from Universal Electronics in Addis Ababa. Browse products, project photographs and direct enquiry options."
>
  <section class="ue-hero" aria-labelledby="home-hero-title">
    <div class="ue-hero-solar" aria-hidden="true">
      <img
        src={withBase('/assets/projects/4650-project-2-1.png')}
        alt=""
        width="1400"
        height="980"
        loading="eager"
      />
    </div>
    <div class="ue-hero-sound" aria-hidden="true">
      <div class="ue-sound-glow"></div>
      <img
        src={withBase('/assets/products/speakers/4982-photo_2025-09-07_08-14-27.jpg')}
        alt=""
        width="900"
        height="900"
        loading="eager"
      />
      <span class="ue-sound-label">Professional sound</span>
    </div>

    <div class="max-w-site mx-auto px-4 sm:px-6 relative z-10 min-h-[520px] lg:min-h-[590px] flex items-center">
      <div class="max-w-[720px] py-16 lg:py-20" data-reveal>
        <p class="ue-hero-kicker">Universal Electronics · Addis Ababa</p>
        <h1 id="home-hero-title" class="ue-hero-title">
          Power what matters.<br />
          <span>Amplify every moment.</span>
        </h1>
        <p class="ue-hero-copy">
          Solar equipment and professional sound systems, brought together in one focused catalog for homes, businesses and project work.
        </p>
        <div class="flex flex-wrap gap-3 mt-9">
          <a href={withBase('/shop/solar/')} class="ue-button-light">
            Explore solar <span aria-hidden="true">↗</span>
          </a>
          <a href={withBase('/shop/sound/')} class="ue-button-ghost">
            Explore sound <span aria-hidden="true">↗</span>
          </a>
          <a href={withBase('/contact/')} class="ue-button-link">
            Request a solution
          </a>
        </div>
        <div class="ue-hero-meta">
          <div><strong>{solarCount}</strong><span>solar products</span></div>
          <div><strong>{soundCount}</strong><span>sound products</span></div>
          <div><strong>{projects.length}</strong><span>project photographs</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white" aria-labelledby="specialties-title">
    <div class="max-w-site mx-auto px-4 sm:px-6">
      <div class="max-w-3xl mb-12 lg:mb-16" data-reveal>
        <p class="section-eyebrow mb-4">Two specialties. One team.</p>
        <h2 id="specialties-title" class="ue-section-title">
          Start with the system you need.
        </h2>
        <p class="ue-section-copy">
          Go straight to solar or sound, then narrow the catalog by product category.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-5 lg:gap-7">
        <a href={withBase('/shop/solar/')} class="ue-specialty-card ue-specialty-solar group" data-reveal>
          <div class="relative z-10">
            <span class="ue-card-index">01 / Solar</span>
            <h3>Solar energy</h3>
            <p>Panels, inverters, batteries, water pumps and portable lighting.</p>
          </div>
          <img
            src={withBase('/assets/products/solar-panels/4707-ja_solar_605w_jam72d40_lb.webp')}
            alt="JA Solar panel from the Universal Electronics catalog"
            width="720"
            height="720"
            loading="lazy"
          />
          <div class="ue-card-footer relative z-10">
            <span>{solarCount} catalog products</span>
            <span aria-hidden="true" class="ue-card-arrow">↗</span>
          </div>
        </a>

        <a href={withBase('/shop/sound/')} class="ue-specialty-card ue-specialty-sound group" data-reveal>
          <div class="relative z-10">
            <span class="ue-card-index">02 / Sound</span>
            <h3>Professional sound</h3>
            <p>Speakers, amplifiers, microphones, mixers and instruments.</p>
          </div>
          <img
            src={withBase('/assets/products/speakers/4982-photo_2025-09-07_08-14-27.jpg')}
            alt="JBL speaker from the Universal Electronics catalog"
            width="720"
            height="720"
            loading="lazy"
          />
          <div class="ue-card-footer relative z-10">
            <span>{soundCount} catalog products</span>
            <span aria-hidden="true" class="ue-card-arrow">↗</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28 bg-[#f4f5f7]" aria-labelledby="solutions-title">
    <div class="max-w-site mx-auto px-4 sm:px-6">
      <div class="grid lg:grid-cols-[.8fr_1.2fr] gap-12 lg:gap-20 items-start">
        <div class="lg:sticky lg:top-32" data-reveal>
          <p class="section-eyebrow mb-4">Shop by application</p>
          <h2 id="solutions-title" class="ue-section-title">Find the right starting point.</h2>
          <p class="ue-section-copy max-w-lg">
            Instead of scrolling through everything, begin with the part of the system you are building.
          </p>
          <a href={withBase('/shop/')} class="text-link mt-7">Browse the full catalog <span aria-hidden="true">↗</span></a>
        </div>

        <div class="border-t border-slate-300">
          {solutionGroups.map((solution) => (
            <a href={withBase(solution.href)} class="ue-solution-row group" data-reveal>
              <span class="ue-solution-number">{solution.number}</span>
              <div>
                <h3>{solution.label}</h3>
                <p>{solution.description}</p>
              </div>
              <span class="ue-solution-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white" aria-labelledby="featured-title">
    <div class="max-w-site mx-auto px-4 sm:px-6">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12" data-reveal>
        <div class="max-w-2xl">
          <p class="section-eyebrow mb-4">Selected equipment</p>
          <h2 id="featured-title" class="ue-section-title">A closer look at the catalog.</h2>
        </div>
        <a href={withBase('/shop/')} class="text-link shrink-0">View all products <span aria-hidden="true">↗</span></a>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-5 border-y border-slate-200">
        {featuredProducts.map((product) => (
          <a href={withBase(`/product/${product.slug}/`)} class="ue-product-tile group">
            <div class="ue-product-image">
              {product.media?.[0] && (
                <img
                  src={withBase(product.media[0])}
                  alt={product.title}
                  width="500"
                  height="500"
                  loading="lazy"
                />
              )}
            </div>
            <div class="pt-5">
              <span class="ue-product-brand">{product.primaryBrand}</span>
              <h3>{product.title}</h3>
              <span class="ue-product-link">View product <span aria-hidden="true">↗</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="ue-project-stage" aria-labelledby="projects-title">
    <div class="max-w-site mx-auto px-4 sm:px-6 py-16 lg:py-20">
      <div class="grid lg:grid-cols-[.82fr_1.18fr] gap-12 lg:gap-20 items-center">
        <div data-reveal>
          <p class="ue-dark-eyebrow">Project archive</p>
          <h2 id="projects-title" class="ue-dark-title">See the work behind the equipment.</h2>
          <p class="ue-dark-copy">
            Browse photographs preserved from previous Universal Electronics projects, then contact the team if you want details about a particular installation.
          </p>
          <div class="flex flex-wrap gap-5 mt-8">
            <a href={withBase('/projects/')} class="ue-dark-link">View projects <span aria-hidden="true">↗</span></a>
            <a href={withBase('/recognition/')} class="ue-dark-link">Recognition <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <div class="ue-project-grid" data-reveal>
          {projects.slice(0, 3).map((project, index) => (
            <figure class={index === 0 ? 'ue-project-main' : 'ue-project-small'}>
              <img
                src={withBase(project.image)}
                alt={`Universal Electronics project archive photograph ${index + 1}`}
                width="900"
                height="700"
                loading="lazy"
              />
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-24 bg-white" aria-labelledby="process-title">
    <div class="max-w-site mx-auto px-4 sm:px-6">
      <div class="max-w-2xl mb-12" data-reveal>
        <p class="section-eyebrow mb-4">Simple enquiry path</p>
        <h2 id="process-title" class="ue-section-title">From product search to direct conversation.</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-px bg-slate-200 border border-slate-200">
        <div class="ue-process-card" data-reveal>
          <span>01</span>
          <h3>Explore</h3>
          <p>Browse solar or sound equipment by category and product.</p>
        </div>
        <div class="ue-process-card" data-reveal>
          <span>02</span>
          <h3>Shortlist</h3>
          <p>Open the product page and review the available catalog details.</p>
        </div>
        <div class="ue-process-card" data-reveal>
          <span>03</span>
          <h3>Enquire</h3>
          <p>Send the product name or your project requirements directly to Universal Electronics.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="ue-final-cta">
    <div class="max-w-site mx-auto px-4 sm:px-6 py-16 lg:py-20 grid lg:grid-cols-[1fr_auto] gap-8 lg:items-center">
      <div data-reveal>
        <p class="ue-dark-eyebrow">Planning a solar or sound system?</p>
        <h2 class="ue-final-title">Tell us what you need.</h2>
        <p class="ue-dark-copy max-w-2xl">
          Send us a product name, a shortlist, or a simple description of the system you are planning.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 lg:justify-end" data-reveal>
        <a href={withBase('/contact/')} class="ue-button-light">Contact Universal <span aria-hidden="true">↗</span></a>
        <a href={`https://wa.me/${siteConfig.whatsappNumber}`} target="_blank" rel="noopener noreferrer" class="ue-button-ghost">
          WhatsApp <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
