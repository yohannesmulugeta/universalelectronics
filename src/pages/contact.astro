---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { siteConfig } from '../data/siteConfig';
---

<Layout title="Contact Us | Universal Electronics"
  description="Contact Universal Electronics in Addis Ababa about solar energy and professional sound products.">
  <div class="max-w-site mx-auto px-5 py-6 sm:px-8">
    <Breadcrumb items={[{ label: 'Contact Us' }]} />
    <section class="grid gap-10 border-b border-brand-border py-8 sm:py-14 lg:grid-cols-[1.4fr_1fr] lg:py-24" data-reveal>
      <div>
        <p class="section-eyebrow mb-6">Contact / Universal Electronics</p>
        <h1 class="max-w-3xl font-serif text-4xl font-semibold leading-tight text-brand-navy sm:text-5xl lg:text-6xl">Let's find what you need.</h1>
      </div>
      <p class="max-w-md self-end text-base leading-8 text-brand-muted">Tell us which product or project you have in mind. Ask about current specifications, availability and quotations through the contact channel that suits you.</p>
    </section>

    <section class="grid gap-6 py-8 sm:gap-10 sm:py-16 lg:grid-cols-[.85fr_1.15fr] lg:gap-20 lg:py-24" aria-labelledby="email-form-heading">
      <div>
        <p class="section-eyebrow mb-5">Email enquiry</p>
        <h2 id="email-form-heading" class="font-serif text-3xl font-semibold leading-tight text-brand-navy sm:text-4xl">Tell us about your requirement.</h2>
        <p class="mt-5 max-w-md text-sm leading-7 text-brand-muted">Complete the form to prepare an email to our team. Your email app will open so you can review and send it.</p>
      </div>
      <form id="contact-email-form" data-email={siteConfig.email} class="space-y-5">
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="contact-name" class="mb-2 block text-sm font-semibold text-brand-navy">Your name <span aria-hidden="true">*</span></label>
            <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="100" class="catalog-field" />
          </div>
          <div>
            <label for="contact-email" class="mb-2 block text-sm font-semibold text-brand-navy">Your email <span aria-hidden="true">*</span></label>
            <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254" class="catalog-field" />
          </div>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="contact-phone" class="mb-2 block text-sm font-semibold text-brand-navy">Phone <span class="font-normal text-brand-muted">(optional)</span></label>
            <input id="contact-phone" name="phone" type="tel" autocomplete="tel" maxlength="30" class="catalog-field" />
          </div>
          <div>
            <label for="contact-interest" class="mb-2 block text-sm font-semibold text-brand-navy">Interested in</label>
            <select id="contact-interest" name="interest" class="catalog-field">
              <option value="Solar equipment">Solar equipment</option>
              <option value="Sound equipment">Sound equipment</option>
              <option value="Project installation">Project installation</option>
              <option value="Other enquiry">Other enquiry</option>
            </select>
          </div>
        </div>
        <div>
          <label for="contact-message" class="mb-2 block text-sm font-semibold text-brand-navy">What do you need? <span aria-hidden="true">*</span></label>
          <textarea id="contact-message" name="message" rows="6" required maxlength="3000" class="catalog-field resize-y" placeholder="Tell us about the product or project, location, and any details that will help us respond."></textarea>
        </div>
        <button type="submit" class="button-primary">Prepare email <span aria-hidden="true">↗</span></button>
        <p id="contact-form-status" class="text-sm leading-6 text-brand-muted" role="status" aria-live="polite"></p>
      </form>
    </section>

    <section class="grid gap-8 border-t border-brand-border py-14 md:grid-cols-3 lg:py-20" aria-label="Contact channels">
      <div class="border-t border-brand-navy pt-6">
        <p class="section-eyebrow mb-5">01 / Message</p>
        <h2 class="font-serif text-2xl font-semibold">Telegram</h2>
        <p class="mt-4 min-h-14 text-sm leading-7 text-brand-muted">Send a product name or describe your requirement.</p>
        <a class="text-link mt-6" href={siteConfig.telegramUrl} target="_blank" rel="noopener noreferrer">Open Telegram <span aria-hidden="true">↗</span></a>
      </div>
      <div class="border-t border-brand-navy pt-6">
        <p class="section-eyebrow mb-5">02 / Call</p>
        <h2 class="font-serif text-2xl font-semibold">Phone</h2>
        <p class="mt-4 min-h-14 text-sm leading-7 text-brand-muted">Speak directly about equipment or a quotation.</p>
        <a class="text-link mt-6" href={`tel:${siteConfig.phones[0].replace(/\s+/g, '')}`}>{siteConfig.phones[0]} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="border-t border-brand-navy pt-6">
        <p class="section-eyebrow mb-5">03 / Write</p>
        <h2 class="font-serif text-2xl font-semibold">Email</h2>
        <p class="mt-4 min-h-14 text-sm leading-7 text-brand-muted">Share details or request information in writing.</p>
        <a class="text-link mt-6 break-all" href={`mailto:${siteConfig.email}`}>{siteConfig.email} <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="mb-24 grid gap-8 bg-brand-offwhite px-8 py-12 sm:px-12 lg:grid-cols-2 lg:px-16 lg:py-16">
      <div><p class="section-eyebrow mb-5">Visit us</p><h2 class="font-serif text-3xl font-semibold">Find us in Addis Ababa.</h2></div>
      <div class="text-sm leading-7 text-brand-muted">
        <p>{siteConfig.address}<br />{siteConfig.city}, {siteConfig.country}</p>
        <p class="mt-4">Office line: <a class="font-semibold text-brand-navy hover:underline" href={`tel:${siteConfig.phones[1].replace(/\s+/g, '')}`}>{siteConfig.phones[1]}</a></p>
        <p class="mt-4">Prefer WhatsApp? <a class="font-semibold text-brand-navy hover:underline" href={`https://wa.me/${siteConfig.whatsappNumber}`} target="_blank" rel="noopener noreferrer">Start a message ↗</a></p>
      </div>
    </section>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-email-form');
  const status = document.querySelector<HTMLElement>('#contact-form-status');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const fields = new FormData(form);
    const value = (name: string) => String(fields.get(name) ?? '').trim();
    const subject = `Universal Electronics enquiry: ${value('interest')}`;
    const body = [
      `Name: ${value('name')}`,
      `Email: ${value('email')}`,
      `Phone: ${value('phone') || 'Not provided'}`,
      `Interest: ${value('interest')}`,
      '',
      value('message'),
    ].join('\n');

    if (status) status.textContent = 'Your email app should open with the message ready. Please send it there.';
    window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
