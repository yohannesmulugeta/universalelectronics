---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { siteConfig } from '../data/siteConfig';
---

<Layout title="Contact Us | Universal Electronics"
  description="Contact Universal Electronics in Addis Ababa about solar energy and professional sound products.">
  <div class="max-w-site mx-auto px-5 py-6 sm:px-8">
    <Breadcrumb items={[{ label: 'Contact Us' }]} />
    <section class="grid gap-10 border-b border-brand-border py-14 lg:grid-cols-[1.4fr_1fr] lg:py-24" data-reveal>
      <div>
        <p class="section-eyebrow mb-6">Contact / Universal Electronics</p>
        <h1 class="max-w-3xl font-serif text-4xl font-semibold leading-tight text-brand-navy sm:text-5xl lg:text-6xl">Let's find what you need.</h1>
      </div>
      <p class="max-w-md self-end text-base leading-8 text-brand-muted">Tell us which product or project you have in mind. Ask about current specifications, availability and quotations through the contact channel that suits you.</p>
    </section>

    <section class="grid gap-8 py-14 md:grid-cols-3 lg:py-20" aria-label="Contact channels">
      <div class="border-t border-brand-navy pt-6">
        <p class="section-eyebrow mb-5">01 / Message</p>
        <h2 class="font-serif text-2xl font-semibold">Telegram</h2>
        <p class="mt-4 min-h-14 text-sm leading-7 text-brand-muted">Send a product name or describe your requirement.</p>
        <a class="text-link mt-6" href={siteConfig.telegramUrl} target="_blank" rel="noopener noreferrer">Open Telegram <span aria-hidden="true">↗</span></a>
      </div>
      <div class="border-t border-brand-navy pt-6">
        <p class="section-eyebrow mb-5">02 / Call</p>
        <h2 class="font-serif text-2xl font-semibold">Phone</h2>
        <p class="mt-4 min-h-14 text-sm leading-7 text-brand-muted">Speak directly about equipment or a quotation.</p>
        <a class="text-link mt-6" href={`tel:${siteConfig.phones[0].replace(/\s+/g, '')}`}>{siteConfig.phones[0]} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="border-t border-brand-navy pt-6">
        <p class="section-eyebrow mb-5">03 / Write</p>
        <h2 class="font-serif text-2xl font-semibold">Email</h2>
        <p class="mt-4 min-h-14 text-sm leading-7 text-brand-muted">Share details or request information in writing.</p>
        <a class="text-link mt-6 break-all" href={`mailto:${siteConfig.email}`}>{siteConfig.email} <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="mb-24 grid gap-8 bg-brand-offwhite px-8 py-12 sm:px-12 lg:grid-cols-2 lg:px-16 lg:py-16">
      <div><p class="section-eyebrow mb-5">Visit us</p><h2 class="font-serif text-3xl font-semibold">Find us in Addis Ababa.</h2></div>
      <div class="text-sm leading-7 text-brand-muted">
        <p>{siteConfig.address}<br />{siteConfig.city}, {siteConfig.country}</p>
        <p class="mt-4">Office line: <a class="font-semibold text-brand-navy hover:underline" href={`tel:${siteConfig.phones[1].replace(/\s+/g, '')}`}>{siteConfig.phones[1]}</a></p>
        <p class="mt-4">Prefer WhatsApp? <a class="font-semibold text-brand-navy hover:underline" href={`https://wa.me/${siteConfig.whatsappNumber}`} target="_blank" rel="noopener noreferrer">Start a message ↗</a></p>
      </div>
    </section>
  </div>
</Layout>
